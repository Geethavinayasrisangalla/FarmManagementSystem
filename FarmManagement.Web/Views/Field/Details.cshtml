@model FarmManagement.Web.Models.Entities.Field

@{
    ViewData["Title"] = "Field Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Field Details</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <!-- Field Info Card -->
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white">
                <strong>@Model.FieldName</strong>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Field ID</dt>
                    <dd class="col-sm-7">@Model.FieldId</dd>

                    <dt class="col-sm-5">Area</dt>
                    <dd class="col-sm-7">@Model.AreaHectares ha</dd>

                    <dt class="col-sm-5">Soil Type</dt>
                    <dd class="col-sm-7">@Model.SoilType</dd>

                    <dt class="col-sm-5">Location</dt>
                    <dd class="col-sm-7">@Model.Location</dd>

                    <dt class="col-sm-5">Created At</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-5">Total Crops</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-primary">
                            @(Model.Crops?.Count() ?? 0)
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Crops in this Field -->
    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
                Crops in this Field
            </div>
            <div class="card-body">
                @if (Model.Crops == null || !Model.Crops.Any())
                {
                    <p class="text-muted">No crops assigned to this field.</p>
                }
                else
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Crop Name</th>
                                <th>Type</th>
                                <th>Season</th>
                                <th>Status</th>
                                <th>Expected Harvest</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var crop in Model.Crops)
                            {
                                <tr>
                                    <td>@crop.CropName</td>
                                    <td>@crop.CropType</td>
                                    <td>@crop.Season</td>
                                    <td>
                                        <span class="badge @(crop.Status == "Growing" ? "bg-success" :
                                                                                                                                                        crop.Status == "Harvested" ? "bg-secondary" : "bg-warning")">
                                            @crop.Status
                                        </span>
                                    </td>
                                    <td>@crop.ExpectedHarvestDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Planting Schedules -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                Planting Schedules
            </div>
            <div class="card-body">
                @if (Model.PlantingSchedules == null || !Model.PlantingSchedules.Any())
                {
                    <p class="text-muted">No planting schedules for this field.</p>
                }
                else
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-warning">
                            <tr>
                                <th>Scheduled Date</th>
                                <th>Expected Yield (kg)</th>
                                <th>Status</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.PlantingSchedules)
                            {
                                <tr>
                                    <td>@schedule.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>@schedule.ExpectedYieldKg</td>
                                    <td>
                                        <span class="badge @(schedule.Status == "Scheduled" ? "bg-primary" :
                                                                                                                                                        schedule.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                            @schedule.Status
                                        </span>
                                    </td>
                                    <td>@(schedule.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.FieldId" class="btn btn-warning">
        <i class="bi bi-pencil"></i> Edit
    </a>
    <form asp-action="Delete" asp-route-id="@Model.FieldId"
          method="post" class="d-inline"
          onsubmit="return confirm('Are you sure you want to delete @Model.FieldName?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger ms-2">
            <i class="bi bi-trash"></i> Delete
        </button>
    </form>
</div>