@model FarmManagement.Web.Models.Entities.Crop

@{
    ViewData["Title"] = "Crop Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Crop Details</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white">
                <strong>@Model.CropName</strong>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Crop Type</dt>
                    <dd class="col-sm-7">@Model.CropType</dd>

                    <dt class="col-sm-5">Season</dt>
                    <dd class="col-sm-7">@Model.Season</dd>

                    <dt class="col-sm-5">Field</dt>
                    <dd class="col-sm-7">@(Model.Field?.FieldName ?? "-")</dd>

                    <dt class="col-sm-5">Planting Date</dt>
                    <dd class="col-sm-7">@Model.PlantingDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-5">Expected Harvest</dt>
                    <dd class="col-sm-7">@Model.ExpectedHarvestDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        <span class="badge @(Model.Status == "Growing" ? "bg-success" :
                                                                                                        Model.Status == "Harvested" ? "bg-secondary" : "bg-warning")">
                            @Model.Status
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-danger text-white">
                Active Pest Incidents
            </div>
            <div class="card-body">
                @if (Model.PestIncidents == null || !Model.PestIncidents.Any())
                {
                    <p class="text-muted">No pest incidents recorded.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var pest in Model.PestIncidents)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@pest.PestName</span>
                                <span class="badge bg-danger">@pest.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                Planting Schedules
            </div>
            <div class="card-body">
                @if (Model.PlantingSchedules == null || !Model.PlantingSchedules.Any())
                {
                    <p class="text-muted">No schedules found.</p>
                }
                else
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Scheduled Date</th>
                                <th>Expected Yield (kg)</th>
                                <th>Status</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.PlantingSchedules)
                            {
                                <tr>
                                    <td>@schedule.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>@schedule.ExpectedYieldKg</td>
                                    <td>
                                        <span class="badge @(schedule.Status == "Scheduled" ? "bg-primary" :
                                                                                                                                                        schedule.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                            @schedule.Status
                                        </span>
                                    </td>
                                    <td>@(schedule.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.CropId" class="btn btn-warning">
        <i class="bi bi-pencil"></i> Edit
    </a>
    <form asp-action="Delete" asp-route-id="@Model.CropId" method="post" class="d-inline"
          onsubmit="return confirm('Are you sure you want to delete @Model.CropName?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger ms-2">
            <i class="bi bi-trash"></i> Delete
        </button>
    </form>
</div>