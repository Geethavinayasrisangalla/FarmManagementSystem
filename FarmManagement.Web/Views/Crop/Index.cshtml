@model IEnumerable<FarmManagement.Web.Models.Entities.Crop>

@{
    ViewData["Title"] = "Crops";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Crop Inventory</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add New Crop
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-success">
                <tr>
                    <th>#</th>
                    <th>Crop Name</th>
                    <th>Crop Type</th>
                    <th>Season</th>
                    <th>Field</th>
                    <th>Planting Date</th>
                    <th>Expected Harvest</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">No crops found.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CropId</td>
                        <td>@item.CropName</td>
                        <td>@item.CropType</td>
                        <td>@item.Season</td>
                        <td>@(item.Field?.FieldName ?? "-")</td>
                        <td>@item.PlantingDate.ToString("dd MMM yyyy")</td>
                        <td>@item.ExpectedHarvestDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge @(item.Status == "Growing" ? "bg-success" :
                                                                                                                    item.Status == "Harvested" ? "bg-secondary" : "bg-warning")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.CropId"
                               class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.CropId"
                               class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.CropId"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete @item.CropName?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>