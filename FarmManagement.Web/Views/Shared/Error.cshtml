@model FarmManagement.Web.Models.ViewModels.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="d-flex justify-content-center align-items-center"
     style="min-height: 60vh;">
    <div class="text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger"
               style="font-size: 5rem;"></i>
        </div>

        <h1 class="display-4 fw-bold text-danger">Oops!</h1>
        <h4 class="text-muted mb-3">Something went wrong.</h4>

        @if (Model.ShowRequestId)
        {
            <div class="alert alert-secondary d-inline-block px-4">
                <small>
                    <strong>Request ID:</strong>
                    <code>@Model.RequestId</code>
                </small>
            </div>
        }

        <p class="text-muted mt-3">
            An unexpected error occurred while processing your request.
            <br />
            Please try again or contact your system administrator.
        </p>

        <div class="mt-4 d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index"
                   class="btn btn-success">
                <i class="bi bi-house"></i> Back to Dashboard
            </a>
            <a href="javascript:history.back()"
                   class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Go Back
            </a>
        </div>
    </div>
</div>