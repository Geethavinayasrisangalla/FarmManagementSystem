@model FarmManagement.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-1 text-danger">⚠️</h1>
        <h2 class="fw-semibold">Something went wrong</h2>
        <p class="text-muted">An unexpected error occurred. Please try again or contact support.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-success mt-3">
            ← Back to Dashboard
        </a>
    </div>
</div>