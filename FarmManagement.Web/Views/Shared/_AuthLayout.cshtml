<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AgroManage</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            overflow-x: hidden;
            background: #050e07;
        }

        /* ════════════════════════════════
           CSS-ONLY PROFESSIONAL BACKGROUND
        ════════════════════════════════ */

        /* Base gradient */
        .auth-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20%  10%, rgba(16,185,129,.13) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 80%  80%, rgba(5, 150,105,.11) 0%, transparent 55%),
                radial-gradient(ellipse 50% 40% at 55%  40%, rgba(22,163, 74,.07) 0%, transparent 50%),
                linear-gradient(160deg, #030c05 0%, #061408 35%, #071c0c 60%, #051008 100%);
        }

        /* Subtle dot-grid overlay */
        .auth-bg::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 28px 28px;
        }

        /* Thin diagonal line texture */
        .auth-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(
                -45deg,
                transparent,
                transparent 38px,
                rgba(255,255,255,.018) 38px,
                rgba(255,255,255,.018) 39px
            );
        }

        /* Aurora blobs — blurred color orbs */
        .auth-blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            z-index: 0;
        }
        .auth-blob-1 {
            width: 560px; height: 560px;
            top: -180px; left: -140px;
            background: radial-gradient(circle, rgba(22,163,74,.22) 0%, transparent 65%);
        }
        .auth-blob-2 {
            width: 480px; height: 480px;
            bottom: -140px; right: -100px;
            background: radial-gradient(circle, rgba(16,185,129,.18) 0%, transparent 65%);
        }
        .auth-blob-3 {
            width: 340px; height: 340px;
            top: 42%; left: 58%;
            background: radial-gradient(circle, rgba(5,150,105,.12) 0%, transparent 65%);
        }

        /* ════════════════════════════════
           PAGE LAYOUT
        ════════════════════════════════ */
        .auth-page {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1rem;
        }

        /* Brand above card */
        .auth-brand-top {
            display: flex;
            align-items: center;
            gap: .8rem;
            margin-bottom: 1.6rem;
        }
        .auth-brand-icon {
            width: 46px; height: 46px;
            background: linear-gradient(135deg, #15803d, #34d399);
            border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; color: #fff;
            box-shadow: 0 0 0 1px rgba(52,211,153,.25), 0 4px 22px rgba(52,211,153,.3);
        }
        .auth-brand-name {
            font-size: 1.18rem; font-weight: 900; color: #f0fdf4; letter-spacing: -.025em;
        }
        .auth-brand-sub {
            font-size: .6rem; color: rgba(255,255,255,.38);
            text-transform: uppercase; letter-spacing: .12em; margin-top: 1px;
        }

        /* Form wrapper */
        .auth-form-wrap { width: 100%; max-width: 420px; }

        /* ── Card ── */
        .auth-card {
            background: rgba(255,255,255,.97);
            border-radius: 20px;
            box-shadow:
                0 0 0 1px rgba(255,255,255,.08),
                0 8px 32px rgba(0,0,0,.28),
                0 32px 72px rgba(0,0,0,.22);
            overflow: hidden;
        }
        .auth-card-body   { padding: 2rem 2rem 1.5rem; }
        .auth-card-footer {
            background: #f8fafc;
            border-top: 1px solid #e9ecef;
            padding: 1rem 2rem;
            text-align: center;
            font-size: .875rem;
        }

        /* ── Form typography ── */
        .auth-card-title {
            font-size: 1.35rem; font-weight: 800;
            color: #0f172a; letter-spacing: -.02em; margin-bottom: .25rem;
        }
        .auth-card-sub   { font-size: .82rem; color: #64748b; margin-bottom: 1.6rem; }
        .form-label      { font-weight: 600; font-size: .8rem; color: #344054; margin-bottom: .35rem; }

        /* ── Inputs ── */
        .input-icon-wrap { position: relative; }
        .input-icon-wrap .input-icon-left {
            position: absolute; left: .85rem; top: 50%;
            transform: translateY(-50%);
            color: #94a3b8; font-size: .9rem; pointer-events: none;
        }
        .input-icon-wrap input,
        .input-icon-wrap select { padding-left: 2.4rem; }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: .6rem .9rem;
            font-size: .875rem;
            background: #fafcff;
            color: #0f172a;
            transition: border-color .18s, box-shadow .18s, background .18s;
            width: 100%;
        }
        .form-control:focus, .form-select:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22,163,74,.13);
            outline: none;
            background: #fff;
        }
        .form-control:hover:not(:focus) { border-color: #c0cdd9; }
        .form-control::placeholder       { color: #b0bec8; }

        /* ── Submit button ── */
        .btn-auth {
            background: linear-gradient(135deg, #15803d 0%, #16a34a 55%, #22c55e 100%);
            border: none; border-radius: 10px;
            color: #fff; font-weight: 700; font-size: .9rem;
            padding: .72rem; width: 100%;
            transition: transform .14s, box-shadow .14s;
            box-shadow: 0 4px 14px rgba(22,163,74,.38);
            display: flex; align-items: center; justify-content: center; gap: .45rem;
            letter-spacing: .01em; cursor: pointer;
        }
        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(22,163,74,.48);
            color: #fff;
        }

        /* ── Footer links ── */
        .auth-footer-text { color: #64748b; }
        .auth-footer-link { color: #16a34a; font-weight: 700; text-decoration: none; }
        .auth-footer-link:hover { text-decoration: underline; color: #15803d; }

        /* ── Role badge chips ── */
        .field-tag {
            display: inline-flex; align-items: center; gap: .25rem;
            font-size: .7rem; font-weight: 600;
            padding: .2rem .55rem; border-radius: 20px; margin: .1rem;
        }

        /* ── Password toggle ── */
        .pw-toggle {
            position: absolute; right: .85rem; top: 50%;
            transform: translateY(-50%);
            cursor: pointer; color: #94a3b8; font-size: .95rem;
        }
        .pw-toggle:hover { color: #64748b; }

        /* ── Page footer ── */
        .auth-page-footer {
            margin-top: 1.5rem;
            font-size: .72rem;
            color: rgba(255,255,255,.22);
            text-align: center;
            letter-spacing: .03em;
        }

        @@media (max-width: 480px) {
            .auth-card-body   { padding: 1.5rem 1.4rem 1.2rem; }
            .auth-card-footer { padding: .9rem 1.4rem; }
        }
    </style>
</head>
<body>

<!-- CSS-ONLY BACKGROUND -->
<div class="auth-bg"></div>
<div class="auth-blob auth-blob-1"></div>
<div class="auth-blob auth-blob-2"></div>
<div class="auth-blob auth-blob-3"></div>

<!-- CENTERED CONTENT -->
<div class="auth-page">

    <!-- Brand -->
    <div class="auth-brand-top">
        <div class="auth-brand-icon"><i class="bi bi-tree-fill"></i></div>
        <div>
            <div class="auth-brand-name">AgroManage</div>
            <div class="auth-brand-sub">Farm Management System</div>
        </div>
    </div>

    <!-- Form card -->
    <div class="auth-form-wrap">
        @RenderBody()
    </div>

    <div class="auth-page-footer">&copy; @DateTime.Now.Year AgroManage</div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
function togglePassword(inputId, iconId) {
    var input = document.getElementById(inputId);
    var icon  = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
    } else {
        input.type = 'password';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
    }
}
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
