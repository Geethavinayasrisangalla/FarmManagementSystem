<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AgroManage</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; font-family: 'Inter', 'Segoe UI', sans-serif; overflow-x: hidden; }

        /* ── Full-page background ── */
        .auth-bg-layer {
            position: fixed;
            inset: 0;
            z-index: 0;
        }
        .auth-bg-layer svg {
            width: 100%;
            height: 100%;
        }
        .auth-bg-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to bottom,
                rgba(2,10,4,.55) 0%,
                rgba(6,22,10,.5) 45%,
                rgba(13,51,20,.4) 100%
            );
        }

        /* ── Page layout ── */
        .auth-page {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        /* ── Brand above card ── */
        .auth-brand-top {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 1.5rem;
        }
        .auth-brand-icon {
            width: 48px; height: 48px;
            background: linear-gradient(135deg, #15803d, #4ade80);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.35rem; color: #fff;
            box-shadow: 0 4px 24px rgba(74,222,128,.45);
        }
        .auth-brand-name {
            font-size: 1.2rem; font-weight: 900; color: #fff; letter-spacing: -.02em;
        }
        .auth-brand-sub {
            font-size: .62rem; color: rgba(255,255,255,.45);
            text-transform: uppercase; letter-spacing: .1em;
        }

        /* ── Form wrapper ── */
        .auth-form-wrap {
            width: 100%;
            max-width: 420px;
        }

        /* ── Form card ── */
        .auth-card {
            background: rgba(255,255,255,.97);
            border-radius: 22px;
            box-shadow: 0 24px 64px rgba(0,0,0,.4), 0 2px 8px rgba(0,0,0,.2);
            border: 1px solid rgba(255,255,255,.7);
            overflow: hidden;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .auth-card-body   { padding: 2rem 2rem 1.5rem; }
        .auth-card-footer {
            background: #f8fafc;
            border-top: 1px solid #e9ecef;
            padding: 1rem 2rem;
            text-align: center;
            font-size: .875rem;
        }

        /* ── Typography ── */
        .auth-card-title { font-size: 1.35rem; font-weight: 800; color: #0f172a; letter-spacing: -.02em; margin-bottom: .25rem; }
        .auth-card-sub   { font-size: .82rem; color: #64748b; margin-bottom: 1.6rem; }
        .form-label      { font-weight: 600; font-size: .8rem; color: #344054; margin-bottom: .35rem; }

        /* ── Inputs ── */
        .input-icon-wrap { position: relative; }
        .input-icon-wrap .input-icon-left {
            position: absolute; left: .85rem; top: 50%;
            transform: translateY(-50%);
            color: #94a3b8; font-size: .9rem; pointer-events: none;
        }
        .input-icon-wrap input,
        .input-icon-wrap select { padding-left: 2.4rem; }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: .6rem .9rem;
            font-size: .875rem;
            background: #fafcff;
            color: #0f172a;
            transition: border-color .18s, box-shadow .18s, background .18s;
            width: 100%;
        }
        .form-control:focus, .form-select:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 3px rgba(22,163,74,.12);
            outline: none;
            background: #fff;
        }
        .form-control:hover:not(:focus) { border-color: #c0cdd9; }
        .form-control::placeholder { color: #b0bec8; }

        /* ── Submit button ── */
        .btn-auth {
            background: linear-gradient(135deg, #15803d 0%, #16a34a 60%, #22c55e 100%);
            border: none; border-radius: 10px;
            color: #fff; font-weight: 700; font-size: .9rem;
            padding: .72rem; width: 100%;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 4px 14px rgba(22,163,74,.35);
            display: flex; align-items: center; justify-content: center; gap: .45rem;
            letter-spacing: .01em;
        }
        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(22,163,74,.45);
            color: #fff;
        }

        /* ── Footer links ── */
        .auth-footer-text { color: #64748b; }
        .auth-footer-link { color: #16a34a; font-weight: 700; text-decoration: none; }
        .auth-footer-link:hover { text-decoration: underline; color: #15803d; }

        /* ── Role badge chips ── */
        .field-tag {
            display: inline-flex; align-items: center; gap: .25rem;
            font-size: .7rem; font-weight: 600;
            padding: .2rem .55rem; border-radius: 20px; margin: .1rem;
        }

        /* ── Password toggle ── */
        .pw-toggle {
            position: absolute; right: .85rem; top: 50%;
            transform: translateY(-50%);
            cursor: pointer; color: #94a3b8; font-size: .95rem;
        }
        .pw-toggle:hover { color: #64748b; }

        /* ── Page footer ── */
        .auth-page-footer {
            margin-top: 1.5rem;
            font-size: .72rem;
            color: rgba(255,255,255,.3);
            text-align: center;
        }

        @@media (max-width: 480px) {
            .auth-card-body   { padding: 1.5rem 1.4rem 1.2rem; }
            .auth-card-footer { padding: .9rem 1.4rem; }
            .auth-brand-top   { margin-bottom: 1.2rem; }
        }
    </style>
</head>
<body>

<!-- ══════════════════════════════════════════
