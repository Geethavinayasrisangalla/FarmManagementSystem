<!-- ══════════════════════════════════════════
     CENTERED AUTH CONTENT
══════════════════════════════════════════ -->
<div class="auth-page">

    <!-- Brand logo -->
    <div class="auth-brand-top">
        <div class="auth-brand-icon"><i class="bi bi-tree-fill"></i></div>
        <div>
            <div class="auth-brand-name">AgroManage</div>
            <div class="auth-brand-sub">Farm Management System</div>
        </div>
    </div>

    <!-- Form card -->
    <div class="auth-form-wrap">
        @RenderBody()
    </div>

    <!-- Page footer -->
    <div class="auth-page-footer">&copy; @DateTime.Now.Year AgroManage — Farm Management System</div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
function togglePassword(inputId, iconId) {
    var input = document.getElementById(inputId);
    var icon  = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
    } else {
        input.type = 'password';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
    }
}
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
