<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FarmManagement</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/farm.css" />
</head>
<body>

@{
    var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isAdmin      = User.IsInRole("Admin");
    var isManager    = User.IsInRole("Farmer");
    var isSupervisor = User.IsInRole("FieldSupervisor");
    var isWorker     = User.IsInRole("Storekeeper");
    var isViewer     = User.IsInRole("Agronomist");

    var canViewCrops     = isAdmin || isManager || isSupervisor || isViewer;
    var canViewSchedules = isAdmin || isManager || isSupervisor || isWorker || isViewer;
    var canViewPest      = isAdmin || isManager || isSupervisor || isWorker;
    var canViewResources = isAdmin || isWorker;
    var canViewReports   = isAdmin || isManager || isSupervisor || isViewer;
    var canManageUsers   = isAdmin;

    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var roleCss  = userRole.ToLower() switch {
        "admin"           => "role-admin",
        "farmer"          => "role-manager",
        "fieldsupervisor" => "role-supervisor",
        "storekeeper"     => "role-worker",
        _                 => "role-viewer"
    };
}

<!-- ═══════════  TOP NAVBAR  ═══════════ -->
<header class="fm-topnav">
    <div class="fm-topnav-inner">

        <!-- Brand -->
        <a class="fm-brand" asp-controller="Home" asp-action="Index">
            <div class="fm-brand-logo"><i class="bi bi-tree-fill"></i></div>
            <div class="fm-brand-text">
                <span class="fm-brand-name">FarmManagement</span>
                <span class="fm-brand-sub">Agricultural System</span>
            </div>
        </a>

        <!-- Hamburger (mobile only) -->
        <button class="fm-hamburger" id="navToggle" aria-label="Menu">
            <i class="bi bi-list"></i>
        </button>

        <!-- Nav -->
        <nav class="fm-nav" id="fmNav">

            <a class="fm-nav-link @(ctrl == "Home" ? "fm-nav-active" : "")"
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>

            @if (canViewCrops)
            {
                <div class="fm-dropdown @(ctrl=="Crop"||ctrl=="Field" ? "fm-dd-active" : "")">
                    <button class="fm-nav-link fm-dd-toggle">
                        <i class="bi bi-flower1"></i><span>Farm</span><i class="bi bi-chevron-down fm-caret"></i>
                    </button>
                    <div class="fm-dd-menu">
                        <div class="fm-dd-label">Farm Management</div>
                        <a class="fm-dd-item @(ctrl=="Crop"?"fm-dd-item-active":"")" asp-controller="Crop" asp-action="Index">
                            <span class="fm-dd-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-flower1"></i></span>
                            <div><div class="fm-dd-title">Crops</div><div class="fm-dd-sub">Manage crop records</div></div>
                        </a>
                        <a class="fm-dd-item @(ctrl=="Field"?"fm-dd-item-active":"")" asp-controller="Field" asp-action="Index">
                            <span class="fm-dd-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-grid-3x3-gap"></i></span>
                            <div><div class="fm-dd-title">Fields</div><div class="fm-dd-sub">View and edit farm fields</div></div>
                        </a>
                    </div>
                </div>
            }

            @if (canViewSchedules)
            {
                <div class="fm-dropdown @(ctrl=="Schedule" ? "fm-dd-active" : "")">
                    <button class="fm-nav-link fm-dd-toggle">
                        <i class="bi bi-calendar3"></i><span>Planning</span><i class="bi bi-chevron-down fm-caret"></i>
                    </button>
                    <div class="fm-dd-menu">
                        <div class="fm-dd-label">Planning &amp; Scheduling</div>
                        <a class="fm-dd-item @(ctrl=="Schedule"&&action!="HarvestList"?"fm-dd-item-active":"")"
                           asp-controller="Schedule" asp-action="Index">
                            <span class="fm-dd-icon" style="background:#fef9c3;color:#ca8a04;"><i class="bi bi-calendar3"></i></span>
                            <div><div class="fm-dd-title">Schedules</div><div class="fm-dd-sub">Planting &amp; harvest schedules</div></div>
                        </a>
                        <a class="fm-dd-item @(ctrl=="Schedule"&&action=="HarvestList"?"fm-dd-item-active":"")"
                           asp-controller="Schedule" asp-action="HarvestList">
                            <span class="fm-dd-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-basket"></i></span>
                            <div><div class="fm-dd-title">Harvests</div><div class="fm-dd-sub">Upcoming &amp; recorded harvests</div></div>
                        </a>
                    </div>
                </div>
            }

            @if (canViewPest || canViewResources)
            {
                <div class="fm-dropdown @(ctrl=="Pest"||ctrl=="Resource" ? "fm-dd-active" : "")">
                    <button class="fm-nav-link fm-dd-toggle">
                        <i class="bi bi-tools"></i><span>Operations</span><i class="bi bi-chevron-down fm-caret"></i>
                    </button>
                    <div class="fm-dd-menu">
                        <div class="fm-dd-label">Operations</div>
                        @if (canViewPest)
                        {
                            <a class="fm-dd-item @(ctrl=="Pest"?"fm-dd-item-active":"")" asp-controller="Pest" asp-action="Index">
                                <span class="fm-dd-icon" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-bug"></i></span>
                                <div><div class="fm-dd-title">Pest Incidents</div><div class="fm-dd-sub">Track and treat pests</div></div>
                            </a>
                        }
                        @if (canViewResources)
                        {
                            <a class="fm-dd-item @(ctrl=="Resource"?"fm-dd-item-active":"")" asp-controller="Resource" asp-action="Index">
                                <span class="fm-dd-icon" style="background:#ffedd5;color:#ea580c;"><i class="bi bi-box-seam"></i></span>
                                <div><div class="fm-dd-title">Resources</div><div class="fm-dd-sub">Inventory &amp; allocation</div></div>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (canViewReports)
            {
                <div class="fm-dropdown @(ctrl=="Report" ? "fm-dd-active" : "")">
                    <button class="fm-nav-link fm-dd-toggle">
                        <i class="bi bi-bar-chart-line"></i><span>Reports</span><i class="bi bi-chevron-down fm-caret"></i>
                    </button>
                    <div class="fm-dd-menu">
                        <div class="fm-dd-label">Analytics &amp; Reports</div>
                        <a class="fm-dd-item @(ctrl=="Report"&&action=="Index"?"fm-dd-item-active":"")"
                           asp-controller="Report" asp-action="Index">
                            <span class="fm-dd-icon" style="background:#ede9fe;color:#7c3aed;"><i class="bi bi-bar-chart-line"></i></span>
                            <div><div class="fm-dd-title">Reports</div><div class="fm-dd-sub">Farm-wide summary</div></div>
                        </a>
                        <a class="fm-dd-item @(ctrl=="Report"&&action=="YieldAnalytics"?"fm-dd-item-active":"")"
                           asp-controller="Report" asp-action="YieldAnalytics">
                            <span class="fm-dd-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-graph-up-arrow"></i></span>
                            <div><div class="fm-dd-title">Yield Analytics</div><div class="fm-dd-sub">Crop yield trends &amp; charts</div></div>
                        </a>
                    </div>
                </div>
            }

            @if (canManageUsers)
            {
                <div class="fm-dropdown @(ctrl=="UserManagement"||ctrl=="Activity" ? "fm-dd-active" : "")">
                    <button class="fm-nav-link fm-dd-toggle">
                        <i class="bi bi-shield-fill"></i><span>Admin</span><i class="bi bi-chevron-down fm-caret"></i>
                    </button>
                    <div class="fm-dd-menu">
                        <div class="fm-dd-label">Administration</div>
                        <a class="fm-dd-item @(ctrl=="UserManagement"?"fm-dd-item-active":"")"
                           asp-controller="UserManagement" asp-action="Index">
                            <span class="fm-dd-icon" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-people"></i></span>
                            <div><div class="fm-dd-title">User Management</div><div class="fm-dd-sub">Accounts, roles &amp; access</div></div>
                        </a>
                        <a class="fm-dd-item @(ctrl=="Activity"?"fm-dd-item-active":"")"
                           asp-controller="Activity" asp-action="Index">
                            <span class="fm-dd-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-activity"></i></span>
                            <div><div class="fm-dd-title">Activity Log</div><div class="fm-dd-sub">Full system audit trail</div></div>
                        </a>
                    </div>
                </div>
            }

        </nav>

        <!-- Right: date + user -->
        <div class="fm-topnav-right">
            <span class="fm-date">
                <i class="bi bi-calendar3"></i>
                @DateTime.Now.ToString("dd MMM yyyy")
            </span>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="fm-dropdown">
                    <button class="fm-user-chip fm-dd-toggle">
                        <div class="fm-user-avatar"><i class="bi bi-person-fill"></i></div>
                        <div class="fm-user-info">
                            <span class="fm-user-name">@User.Identity.Name</span>
                            <span class="urole @roleCss" style="font-size:.6rem;padding:.05rem .38rem;">@(userRole == "FieldSupervisor" ? "Field Supervisor" : userRole)</span>
                        </div>
                        <i class="bi bi-chevron-down fm-caret" style="font-size:.6rem;color:rgba(255,255,255,.4);"></i>
                    </button>
                    <div class="fm-dd-menu fm-dd-menu-end">
                        <div class="fm-dd-label">Signed in as @User.Identity.Name</div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0" id="logoutForm">
                            @Html.AntiForgeryToken()
                            <button type="button" class="fm-dd-item" style="width:100%;border:none;cursor:pointer;background:none;" onclick="confirmLogout()">
                                <span class="fm-dd-icon" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-box-arrow-left"></i></span>
                                <div><div class="fm-dd-title">Logout</div><div class="fm-dd-sub">End your session</div></div>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-fm btn-outline-fm btn-sm-fm">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn-fm btn-primary-fm btn-sm-fm">
                    <i class="bi bi-person-plus"></i> Register
                </a>
            }
        </div>

    </div>
</header>

<!-- ═══════════  PAGE BODY  ═══════════ -->
<div id="main-content">
    <div class="fm-subnav">
        <span class="fm-subnav-title">
            <i class="bi bi-house-fill" style="color:var(--fm-green);font-size:.72rem;"></i>
            @ViewData["Title"]
        </span>
    </div>

    <div class="page-content">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <span>&copy; @DateTime.Now.Year FarmManagement System</span>
        <span>Built with ASP.NET Core MVC</span>
    </footer>
</div>

<!-- Logout Confirmation Modal -->
<div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none;">
            <div class="modal-body text-center p-4">
                <div style="width:64px;height:64px;background:#fee2e2;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:1rem;">
                    <i class="bi bi-box-arrow-left" style="font-size:1.5rem;color:#dc2626;"></i>
                </div>
                <h5 class="fw-bold mb-2">Confirm Logout</h5>
                <p class="text-muted small mb-4">Are you sure you want to log out of your account?</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
                    <button type="button" class="btn btn-danger px-4" style="border-radius:10px;" onclick="document.getElementById('logoutForm').submit();">Logout</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
(function(){
    // Mobile hamburger
    var toggle = document.getElementById('navToggle');
    var nav    = document.getElementById('fmNav');
    if(toggle && nav){
        toggle.addEventListener('click', function(){ nav.classList.toggle('open'); });
    }
    // Dropdowns
    document.querySelectorAll('.fm-dd-toggle').forEach(function(btn){
        btn.addEventListener('click', function(e){
            e.stopPropagation();
            var parent = this.closest('.fm-dropdown');
            var isOpen = parent.classList.contains('open');
            document.querySelectorAll('.fm-dropdown.open').forEach(function(d){ d.classList.remove('open'); });
            if(!isOpen) parent.classList.add('open');
        });
    });
    document.addEventListener('click', function(){
        document.querySelectorAll('.fm-dropdown.open').forEach(function(d){ d.classList.remove('open'); });
    });
})();
function confirmLogout() {
    var modal = new bootstrap.Modal(document.getElementById('logoutModal'));
    modal.show();
}
</script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
