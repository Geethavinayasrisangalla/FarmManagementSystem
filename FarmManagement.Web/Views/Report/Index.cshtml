@model FarmManagement.Web.Models.ViewModels.ReportDashboardViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-bar-chart-line"></i>
            </span>
            Farm Reports
        </h1>
        <p>Complete overview of farm performance — fields, crops, schedules, harvests, resources and pest incidents.</p>
    </div>
</div>

<!-- ══════════════ SUMMARY STATS ══════════════ -->
<div class="row g-3 mb-4">
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-grid-3x3-gap"></i></div>
            <div><div class="stat-value">@Model.TotalFields</div><div class="stat-label">Fields (@Model.TotalFieldArea.ToString("N1") ha)</div></div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-flower1"></i></div>
            <div><div class="stat-value">@Model.TotalCrops</div><div class="stat-label">Crops</div></div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#ffedd5;color:#ea580c;"><i class="bi bi-box-seam"></i></div>
            <div><div class="stat-value">@Model.TotalResources</div><div class="stat-label">Resources (@Model.LowStockCount low)</div></div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-graph-up"></i></div>
            <div><div class="stat-value">@Model.TotalYieldKg.ToString("N0") kg</div><div class="stat-label">Total Yield (@Model.TotalHarvests harvests)</div></div>
        </div>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-calendar3"></i></div>
            <div><div class="stat-value">@Model.TotalSchedules</div><div class="stat-label">Schedules</div></div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef9c3;color:#ca8a04;"><i class="bi bi-clock"></i></div>
            <div><div class="stat-value" style="color:#ca8a04;">@Model.ScheduledCount</div><div class="stat-label">Scheduled</div></div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-check-circle"></i></div>
            <div><div class="stat-value" style="color:#16a34a;">@Model.CompletedCount</div><div class="stat-label">Completed</div></div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-bug"></i></div>
            <div><div class="stat-value" style="color:#dc2626;">@Model.ActivePests</div><div class="stat-label">Active Pests (of @Model.TotalPestIncidents)</div></div>
        </div>
    </div>
</div>

<!-- ══════════════ ANALYTICS CHARTS ══════════════ -->
<div class="row g-4 mb-4">
    <!-- Pest Status Doughnut -->
    <div class="col-lg-3 col-md-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-bug" style="color:#dc2626;"></i> Pest Status</span>
            </div>
            <div style="padding:1rem 1.25rem 1.25rem;display:flex;flex-direction:column;align-items:center;">
                <canvas id="pestDonut" height="200"></canvas>
                <div style="display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center;margin-top:.9rem;">
                    <span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;border-radius:50%;background:#dc2626;display:inline-block;"></span>Active (@Model.ActivePests)</span>
                    <span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;border-radius:50%;background:#f59e0b;display:inline-block;"></span>Monitoring (@Model.MonitoringPests)</span>
                    <span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;border-radius:50%;background:#16a34a;display:inline-block;"></span>Resolved (@Model.ResolvedPests)</span>
                </div>
            </div>
        </div>
    </div>
    <!-- Schedule Status Doughnut -->
    <div class="col-lg-3 col-md-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-calendar3" style="color:#2563eb;"></i> Schedule Status</span>
            </div>
            <div style="padding:1rem 1.25rem 1.25rem;display:flex;flex-direction:column;align-items:center;">
                <canvas id="schedDonut" height="200"></canvas>
                <div style="display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center;margin-top:.9rem;">
                    <span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;border-radius:50%;background:#2563eb;display:inline-block;"></span>Scheduled (@Model.ScheduledCount)</span>
                    <span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;border-radius:50%;background:#16a34a;display:inline-block;"></span>Completed (@Model.CompletedCount)</span>
                    <span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;border-radius:50%;background:#94a3b8;display:inline-block;"></span>Other (@(Model.TotalSchedules - Model.ScheduledCount - Model.CompletedCount))</span>
                </div>
            </div>
        </div>
    </div>
    <!-- Crop Status Doughnut -->
    <div class="col-lg-3 col-md-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-flower1" style="color:#16a34a;"></i> Crop Status</span>
            </div>
            <div style="padding:1rem 1.25rem 1.25rem;display:flex;flex-direction:column;align-items:center;">
                <canvas id="cropDonut" height="200"></canvas>
                <div style="display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center;margin-top:.9rem;" id="cropLegend"></div>
            </div>
        </div>
    </div>
    <!-- Resource Types Doughnut -->
    <div class="col-lg-3 col-md-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-box-seam" style="color:#ea580c;"></i> Resource Types</span>
            </div>
            <div style="padding:1rem 1.25rem 1.25rem;display:flex;flex-direction:column;align-items:center;">
                <canvas id="resDonut" height="200"></canvas>
                <div style="display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center;margin-top:.9rem;" id="resLegend"></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Resource Quantity by Type — Horizontal Bar -->
    <div class="col-lg-7">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-bar-chart-fill" style="color:#ea580c;"></i> Resource Quantity by Type</span>
                <span style="font-size:.72rem;color:var(--fm-muted);">Total stock per category</span>
            </div>
            <div style="padding:1rem 1.25rem 1.25rem;">
                <canvas id="resBarChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <!-- Pests by Crop — Stacked Bar -->
    <div class="col-lg-5">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title"><i class="bi bi-bug" style="color:#dc2626;"></i> Pest Incidents by Crop</span>
                <span style="font-size:.72rem;color:var(--fm-muted);">Active · Monitoring · Resolved</span>
            </div>
            <div style="padding:1rem 1.25rem 1.25rem;">
                <canvas id="pestByCropChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════ 1. FIELD RECORDS ══════════════ -->
<div class="fm-card mb-4">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-grid-3x3-gap" style="color:#16a34a;"></i> Field Records</span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.TotalFields records</span>
    </div>
    @if (!Model.FieldHistory.Any())
    {
        <div class="empty-state"><i class="bi bi-grid-3x3-gap"></i><p>No fields found.</p></div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>S.No</th><th>Field Name</th><th>Area (ha)</th><th>Soil Type</th><th>Location</th><th>Crops</th></tr>
                </thead>
                <tbody>
                    @{ var fSno = 1; }
                    @foreach (var f in Model.FieldHistory)
                    {
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(fSno++)</td>
                            <td style="font-weight:600;">@f.FieldName</td>
                            <td>@f.AreaHectares.ToString("N2")</td>
                            <td>@f.SoilType</td>
                            <td>@f.Location</td>
                            <td><span class="badge-pill badge-blue">@f.Crops.Count</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ══════════════ 2. CROP RECORDS ══════════════ -->
<div class="fm-card mb-4">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-flower1" style="color:#2563eb;"></i> Crop Records</span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.TotalCrops records</span>
    </div>
    @if (!Model.CropHistory.Any())
    {
        <div class="empty-state"><i class="bi bi-flower1"></i><p>No crops found.</p></div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>S.No</th><th>Crop Name</th><th>Type</th><th>Season</th><th>Field</th><th>Planting Date</th><th>Expected Harvest</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @{ var cSno = 1; }
                    @foreach (var c in Model.CropHistory)
                    {
                        var cBadge = c.Status switch { "Growing" => "badge-green", "Harvested" => "badge-blue", _ => "badge-gray" };
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(cSno++)</td>
                            <td style="font-weight:600;">@c.CropName</td>
                            <td>@c.CropType</td>
                            <td><span class="badge-pill badge-gray">@c.Season</span></td>
                            <td>@(c.Field?.FieldName ?? "—")</td>
                            <td>@c.PlantingDate.ToString("dd MMM yyyy")</td>
                            <td>@c.ExpectedHarvestDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge-pill @cBadge">@c.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ══════════════ 3. SCHEDULE HISTORY ══════════════ -->
<div class="fm-card mb-4">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-calendar3" style="color:#2563eb;"></i> Schedule History</span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.TotalSchedules records</span>
    </div>
    @if (!Model.ScheduleHistory.Any())
    {
        <div class="empty-state"><i class="bi bi-calendar3"></i><p>No schedules found.</p></div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>S.No</th><th>Crop</th><th>Field</th><th>Scheduled Date</th><th>Expected Yield</th><th>Status</th><th>Notes</th></tr>
                </thead>
                <tbody>
                    @{ var sSno = 1; }
                    @foreach (var s in Model.ScheduleHistory)
                    {
                        var schBadge = s.Status switch { "Completed" => "badge-green", "Cancelled" => "badge-gray", "Scheduled" => "badge-blue", _ => "badge-yellow" };
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(sSno++)</td>
                            <td style="font-weight:600;">@(s.Crop?.CropName ?? "—")</td>
                            <td>@(s.Field?.FieldName ?? "—")</td>
                            <td>@s.ScheduledDate.ToString("dd MMM yyyy")</td>
                            <td style="font-weight:700;color:#2563eb;">@s.ExpectedYieldKg kg</td>
                            <td><span class="badge-pill @schBadge">@s.Status</span></td>
                            <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@(s.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ══════════════ 4. HARVEST HISTORY ══════════════ -->
<div class="fm-card mb-4">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-basket" style="color:#16a34a;"></i> Harvest History</span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.TotalHarvests records | Avg: @Model.AverageYieldKg.ToString("N1") kg</span>
    </div>
    @if (!Model.HarvestHistory.Any())
    {
        <div class="empty-state"><i class="bi bi-basket"></i><p>No harvest records found.</p></div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>S.No</th><th>Crop</th><th>Field</th><th>Harvested Date</th><th>Actual Yield</th><th>Notes</th></tr>
                </thead>
                <tbody>
                    @{ var hSno = 1; }
                    @foreach (var h in Model.HarvestHistory)
                    {
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(hSno++)</td>
                            <td style="font-weight:600;">@(h.PlantingSchedule?.Crop?.CropName ?? "—")</td>
                            <td>@(h.PlantingSchedule?.Field?.FieldName ?? "—")</td>
                            <td>@h.HarvestedDate.ToString("dd MMM yyyy")</td>
                            <td style="font-weight:700;color:#16a34a;">@h.ActualYieldKg kg</td>
                            <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@(h.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ══════════════ 5. RESOURCE INVENTORY ══════════════ -->
<div class="fm-card mb-4">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-box-seam" style="color:#ea580c;"></i> Resource Inventory</span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.TotalResources resources</span>
    </div>
    @if (!Model.ResourceHistory.Any())
    {
        <div class="empty-state"><i class="bi bi-box-seam"></i><p>No resources found.</p></div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>S.No</th><th>Name</th><th>Type</th><th>Quantity</th><th>Unit</th><th>Allocations</th><th>Stock Status</th><th>Last Updated</th></tr>
                </thead>
                <tbody>
                    @{ var rSno = 1; }
                    @foreach (var r in Model.ResourceHistory)
                    {
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(rSno++)</td>
                            <td style="font-weight:600;">@r.Name</td>
                            <td><span class="badge-pill badge-gray">@r.Type</span></td>
                            <td style="font-weight:700;color:@(r.Quantity <= 10 ? "#dc2626" : "#16a34a");">@r.Quantity</td>
                            <td>@r.Unit</td>
                            <td>@r.ResourceUsages.Count</td>
                            <td>
                                @if (r.Quantity <= 10)
                                { <span class="badge-pill badge-red">Low</span> }
                                else if (r.Quantity <= 50)
                                { <span class="badge-pill badge-yellow">Medium</span> }
                                else
                                { <span class="badge-pill badge-green">In Stock</span> }
                            </td>
                            <td>@r.LastUpdated.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ══════════════ 6. PEST INCIDENT HISTORY ══════════════ -->
<div class="fm-card mb-4">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-bug" style="color:#dc2626;"></i> Pest Incident History</span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.TotalPestIncidents records</span>
    </div>
    @if (!Model.PestHistory.Any())
    {
        <div class="empty-state"><i class="bi bi-shield-check"></i><p>No pest incidents recorded.</p></div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr><th>S.No</th><th>Pest Name</th><th>Disease Name</th><th>Crop</th><th>Reported</th><th>Description</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @{ var pSno = 1; }
                    @foreach (var p in Model.PestHistory)
                    {
                        var badge = p.Status switch {
                            FarmManagement.Web.Models.Enums.IncidentStatus.Active => "badge-red",
                            FarmManagement.Web.Models.Enums.IncidentStatus.Monitoring => "badge-yellow",
                            _ => "badge-green"
                        };
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(pSno++)</td>
                            <td style="font-weight:600;">@p.PestName</td>
                            <td>@(p.DiseaseName ?? "—")</td>
                            <td>@(p.Crop?.CropName ?? "—")</td>
                            <td>@p.ReportedDate.ToString("dd MMM yyyy")</td>
                            <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@(p.Description ?? "—")</td>
                            <td><span class="badge-pill @badge">@p.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>


@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(function () {
    const tooltipDefaults = {
        backgroundColor: '#1e293b', titleColor: '#94a3b8', bodyColor: '#e2e8f0',
        borderColor: '#334155', borderWidth: 1, cornerRadius: 8, padding: 12
    };

    function doughnut(id, labels, data, colors) {
        const ctx = document.getElementById(id);
        if (!ctx) return;
        new Chart(ctx, {
            type: 'doughnut',
            data: { labels, datasets: [{ data, backgroundColor: colors, borderColor: '#fff', borderWidth: 3, hoverOffset: 10 }] },
            options: {
                responsive: true, cutout: '65%',
                plugins: {
                    legend: { display: false },
                    tooltip: { ...tooltipDefaults, callbacks: { label: c => '  ' + c.label + ': ' + c.parsed } }
                },
                animation: { animateRotate: true, duration: 900 }
            }
        });
    }

    // ── Pest Status ──
    doughnut('pestDonut',
        ['Active', 'Monitoring', 'Resolved'],
        [@Model.ActivePests, @Model.MonitoringPests, @Model.ResolvedPests],
        ['rgba(220,38,38,.8)', 'rgba(245,158,11,.8)', 'rgba(22,163,74,.8)']);

    // ── Schedule Status ──
    const otherSched = @Model.TotalSchedules - @Model.ScheduledCount - @Model.CompletedCount;
    doughnut('schedDonut',
        ['Scheduled', 'Completed', 'Other'],
        [@Model.ScheduledCount, @Model.CompletedCount, otherSched < 0 ? 0 : otherSched],
        ['rgba(37,99,235,.8)', 'rgba(22,163,74,.8)', 'rgba(148,163,184,.8)']);

    // ── Crops by Status ──
    const cropLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CropsByStatus.Select(s => s.Status).ToList()));
    const cropCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CropsByStatus.Select(s => s.Count).ToList()));
    const cropPalette = ['rgba(22,163,74,.8)', 'rgba(37,99,235,.8)', 'rgba(245,158,11,.8)', 'rgba(148,163,184,.8)', 'rgba(124,58,237,.8)'];
    doughnut('cropDonut', cropLabels, cropCounts, cropPalette.slice(0, cropLabels.length));
    const cropLeg = document.getElementById('cropLegend');
    if (cropLeg) cropLabels.forEach((l, i) => {
        cropLeg.innerHTML += `<span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;">
            <span style="width:10px;height:10px;border-radius:50%;background:${cropPalette[i]};display:inline-block;"></span>${l} (${cropCounts[i]})</span>`;
    });

    // ── Resources by Type Doughnut ──
    const resLabels  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ResourcesByType.Select(r => r.Type).ToList()));
    const resCounts  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ResourcesByType.Select(r => r.Count).ToList()));
    const resTotals  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ResourcesByType.Select(r => r.TotalQty).ToList()));
    const resPalette = ['rgba(234,88,12,.8)', 'rgba(37,99,235,.8)', 'rgba(22,163,74,.8)', 'rgba(245,158,11,.8)', 'rgba(124,58,237,.8)', 'rgba(148,163,184,.8)'];
    doughnut('resDonut', resLabels, resCounts, resPalette.slice(0, resLabels.length));
    const resLeg = document.getElementById('resLegend');
    if (resLeg) resLabels.forEach((l, i) => {
        resLeg.innerHTML += `<span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;">
            <span style="width:10px;height:10px;border-radius:50%;background:${resPalette[i]};display:inline-block;"></span>${l} (${resCounts[i]})</span>`;
    });

    // ── Resource Quantity Horizontal Bar ──
    const resBarCtx = document.getElementById('resBarChart');
    if (resBarCtx && resLabels.length) {
        new Chart(resBarCtx, {
            type: 'bar',
            data: {
                labels: resLabels,
                datasets: [{
                    label: 'Total Quantity',
                    data: resTotals,
                    backgroundColor: resPalette.slice(0, resLabels.length),
                    borderColor: resPalette.map(c => c.replace('.8)', '1)')),
                    borderWidth: 2, borderRadius: 7, borderSkipped: false
                }]
            },
            options: {
                indexAxis: 'y', responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: { ...tooltipDefaults, callbacks: { label: c => '  ' + c.parsed.x.toLocaleString() + ' units' } }
                },
                scales: {
                    x: { beginAtZero: true, grid: { color: 'rgba(0,0,0,.06)' }, ticks: { color: '#64748b', font: { size: 11 } }, border: { display: false } },
                    y: { grid: { display: false }, ticks: { color: '#374151', font: { size: 12, weight: '600' } }, border: { display: false } }
                },
                animation: { duration: 900, easing: 'easeOutQuart' }
            }
        });
    }

    // ── Pests by Crop Stacked Bar ──
    const pestCropLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PestsByCrop.Select(p => p.CropName).ToList()));
    const pestActive     = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PestsByCrop.Select(p => p.Active).ToList()));
    const pestMonitor    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PestsByCrop.Select(p => p.Monitoring).ToList()));
    const pestResolved   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PestsByCrop.Select(p => p.Resolved).ToList()));
    const pestCropCtx = document.getElementById('pestByCropChart');
    if (pestCropCtx && pestCropLabels.length) {
        new Chart(pestCropCtx, {
            type: 'bar',
            data: {
                labels: pestCropLabels,
                datasets: [
                    { label: 'Active',     data: pestActive,   backgroundColor: 'rgba(220,38,38,.75)',  borderRadius: 4 },
                    { label: 'Monitoring', data: pestMonitor,  backgroundColor: 'rgba(245,158,11,.75)', borderRadius: 4 },
                    { label: 'Resolved',   data: pestResolved, backgroundColor: 'rgba(22,163,74,.75)',  borderRadius: 4 }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom', labels: { color: '#475569', font: { size: 11 }, usePointStyle: true, pointStyle: 'circle', padding: 12 } },
                    tooltip: { ...tooltipDefaults, mode: 'index', intersect: false }
                },
                scales: {
                    x: { stacked: true, grid: { display: false }, ticks: { color: '#374151', font: { size: 11, weight: '600' } }, border: { display: false } },
                    y: { stacked: true, beginAtZero: true, grid: { color: 'rgba(0,0,0,.06)' }, ticks: { stepSize: 1, color: '#64748b', font: { size: 11 } }, border: { display: false } }
                },
                animation: { duration: 900, easing: 'easeOutQuart' }
            }
        });
    }
})();
</script>
}
