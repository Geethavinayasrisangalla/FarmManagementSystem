@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-bar-chart-line"></i>
            </span>
            Reports
        </h1>
        <p>Access farm analytics, pest summaries and inventory reports.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="fm-card h-100" style="display:flex;flex-direction:column;">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-graph-up-arrow" style="color:#16a34a;"></i>
                    Yield Analytics
                </span>
            </div>
            <div class="fm-card-body" style="flex:1;">
                <p style="font-size:.875rem;color:var(--fm-muted);margin:0;">
                    View harvest yield records across all crops and seasons.
                    Includes total yield, average yield and crop-wise breakdown.
                </p>
            </div>
            <div style="padding:.85rem 1.25rem;border-top:1px solid var(--fm-border);">
                <a asp-action="YieldAnalytics" class="btn-fm btn-primary-fm" style="width:100%;justify-content:center;">
                    <i class="bi bi-bar-chart"></i> View Yield Analytics
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="fm-card h-100" style="display:flex;flex-direction:column;">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-bug" style="color:#dc2626;"></i>
                    Pest Incident Summary
                </span>
            </div>
            <div class="fm-card-body" style="flex:1;">
                <p style="font-size:.875rem;color:var(--fm-muted);margin:0;">
                    Overview of all pest incidents reported across crops.
                    Filter by status — Active, Monitoring or Resolved.
                </p>
            </div>
            <div style="padding:.85rem 1.25rem;border-top:1px solid var(--fm-border);">
                <a asp-controller="Pest" asp-action="Index" class="btn-fm btn-danger-fm" style="width:100%;justify-content:center;">
                    <i class="bi bi-bug"></i> View Pest Incidents
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="fm-card h-100" style="display:flex;flex-direction:column;">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-box-seam" style="color:#ea580c;"></i>
                    Resource Inventory
                </span>
            </div>
            <div class="fm-card-body" style="flex:1;">
                <p style="font-size:.875rem;color:var(--fm-muted);margin:0;">
                    Check current stock levels for all resources.
                    Highlights low stock items that need restocking.
                </p>
            </div>
            <div style="padding:.85rem 1.25rem;border-top:1px solid var(--fm-border);">
                <a asp-controller="Resource" asp-action="Index" class="btn-fm btn-warn-fm" style="width:100%;justify-content:center;">
                    <i class="bi bi-box-seam"></i> View Inventory
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="fm-card h-100" style="display:flex;flex-direction:column;">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-calendar3" style="color:#2563eb;"></i>
                    Schedule Overview
                </span>
            </div>
            <div class="fm-card-body" style="flex:1;">
                <p style="font-size:.875rem;color:var(--fm-muted);margin:0;">
                    View all planting schedules including upcoming harvests
                    within the next 30 days.
                </p>
            </div>
            <div style="padding:.85rem 1.25rem;border-top:1px solid var(--fm-border);">
                <a asp-controller="Schedule" asp-action="HarvestList" class="btn-fm btn-info-fm" style="width:100%;justify-content:center;">
                    <i class="bi bi-calendar-check"></i> View Upcoming Harvests
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="fm-card h-100" style="display:flex;flex-direction:column;">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-flower1" style="color:#2563eb;"></i>
                    Crop Overview
                </span>
            </div>
            <div class="fm-card-body" style="flex:1;">
                <p style="font-size:.875rem;color:var(--fm-muted);margin:0;">
                    View all crops currently growing across all fields
                    with season and status information.
                </p>
            </div>
            <div style="padding:.85rem 1.25rem;border-top:1px solid var(--fm-border);">
                <a asp-controller="Crop" asp-action="Index" class="btn-fm btn-outline-fm" style="width:100%;justify-content:center;">
                    <i class="bi bi-flower1"></i> View Crops
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="fm-card h-100" style="display:flex;flex-direction:column;">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-grid-3x3-gap" style="color:#16a34a;"></i>
                    Field Overview
                </span>
            </div>
            <div class="fm-card-body" style="flex:1;">
                <p style="font-size:.875rem;color:var(--fm-muted);margin:0;">
                    View all registered fields with area, soil type,
                    location and number of assigned crops.
                </p>
            </div>
            <div style="padding:.85rem 1.25rem;border-top:1px solid var(--fm-border);">
                <a asp-controller="Field" asp-action="Index" class="btn-fm btn-outline-fm" style="width:100%;justify-content:center;">
                    <i class="bi bi-grid-3x3-gap"></i> View Fields
                </a>
            </div>
        </div>
    </div>
</div>
