@model FarmManagement.Web.Models.ViewModels.YieldAnalyticsViewModel

@{
    ViewData["Title"] = "Yield Analytics";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-graph-up-arrow"></i>
            </span>
            Yield Analytics
        </h1>
        <p>Harvest yield records, averages and crop-wise breakdown.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to Reports
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-graph-up"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#16a34a;font-size:1.3rem;">
                    @Model.TotalYield.ToString("N0") kg
                </div>
                <div class="stat-label">Total Yield (All Time)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-calculator"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#2563eb;font-size:1.3rem;">
                    @Model.AverageYield.ToString("N0") kg
                </div>
                <div class="stat-label">Average Yield Per Harvest</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe;color:#0284c7;">
                <i class="bi bi-basket"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#0284c7;">@Model.Records.Count()</div>
                <div class="stat-label">Total Harvest Records</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Records.Any())
{
    <div class="mb-4" style="border-radius:14px;overflow:hidden;border:1px solid #1e3a4a;box-shadow:0 4px 24px rgba(0,0,0,.18);">
        <div style="background:#0d1b2a;padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #1e3a4a;">
            <span style="font-weight:600;font-size:.92rem;color:#e2e8f0;display:flex;align-items:center;gap:.45rem;">
                <i class="bi bi-graph-up-arrow" style="color:#16a34a;"></i>
                Crop Yield Progress
            </span>
            <span style="font-size:.75rem;color:#64748b;">Actual harvest yield (kg) per crop over time</span>
        </div>
        <div style="background:#0d1b2a;padding:1.5rem 1.25rem 1rem;">
            <canvas id="yieldChart" height="85"></canvas>
        </div>
    </div>
}

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title">
            <i class="bi bi-table" style="color:#16a34a;"></i>
            Harvest Records
        </span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Records.Count() records</span>
    </div>
    @if (!Model.Records.Any())
    {
        <div class="empty-state">
            <i class="bi bi-basket"></i>
            <p>No harvest records found yet.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Crop</th>
                        <th>Field</th>
                        <th>Harvested Date</th>
                        <th>Expected (kg)</th>
                        <th>Actual (kg)</th>
                        <th>Variance</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        var expected = record.PlantingSchedule?.ExpectedYieldKg ?? 0;
                        var actual = record.ActualYieldKg;
                        var variance = actual - expected;
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@record.HarvestId</td>
                            <td style="font-weight:600;">@(record.PlantingSchedule?.Crop?.CropName ?? "—")</td>
                            <td>@(record.PlantingSchedule?.Field?.FieldName ?? "—")</td>
                            <td>@record.HarvestedDate.ToString("dd MMM yyyy")</td>
                            <td>@expected.ToString("N0") kg</td>
                            <td style="font-weight:700;color:#16a34a;">@actual.ToString("N0") kg</td>
                            <td>
                                @if (variance >= 0)
                                {
                                    <span class="badge-pill badge-green">+@variance.ToString("N0") kg</span>
                                }
                                else
                                {
                                    <span class="badge-pill badge-red">@variance.ToString("N0") kg</span>
                                }
                            </td>
                            <td>@(record.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        // Serialize all records with crop, field, date, yield
        const allRecords = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Records
                .OrderBy(r => r.HarvestedDate)
                .Select(r => new {
                    crop  = r.PlantingSchedule != null && r.PlantingSchedule.Crop  != null ? r.PlantingSchedule.Crop.CropName   : "Unknown",
                    field = r.PlantingSchedule != null && r.PlantingSchedule.Field != null ? r.PlantingSchedule.Field.FieldName  : "Unknown",
                    date  = r.HarvestedDate.ToString("dd MMM yy"),
                    yield = r.ActualYieldKg
                })
        ));

        // Unique sorted dates (x-axis labels)
        const allDates = [...new Set(allRecords.map(r => r.date))];

        // Unique crop names
        const crops = [...new Set(allRecords.map(r => r.crop))];

        // Color palette (looks good on dark background)
        const palette = [
            { line: '#f59e0b', point: '#f59e0b' },  // amber
            { line: '#22c55e', point: '#22c55e' },  // green
            { line: '#60a5fa', point: '#60a5fa' },  // blue
            { line: '#a78bfa', point: '#a78bfa' },  // purple
            { line: '#f87171', point: '#f87171' },  // red
            { line: '#34d399', point: '#34d399' },  // emerald
            { line: '#fb923c', point: '#fb923c' },  // orange
            { line: '#38bdf8', point: '#38bdf8' },  // sky
        ];

        // Build one dataset per crop
        const datasets = crops.map((cropName, i) => {
            const color = palette[i % palette.length];
            const cropData = allDates.map(date => {
                const rec = allRecords.find(r => r.crop === cropName && r.date === date);
                return rec ? Number(rec.yield) : null;
            });
            return {
                label: cropName,
                data: cropData,
                borderColor: color.line,
                backgroundColor: 'transparent',
                pointBackgroundColor: color.point,
                pointBorderColor: '#0d1b2a',
                pointBorderWidth: 2,
                pointRadius: 6,
                pointHoverRadius: 9,
                pointHoverBorderColor: '#fff',
                borderWidth: 2.2,
                tension: 0.35,
                spanGaps: true
            };
        });

        const ctx = document.getElementById('yieldChart').getContext('2d');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: allDates,
                datasets: datasets
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            color: '#cbd5e1',
                            font: { size: 12, family: "'Segoe UI', system-ui, sans-serif" },
                            usePointStyle: true,
                            pointStyleWidth: 14,
                            padding: 20,
                            boxHeight: 8
                        }
                    },
                    title: {
                        display: true,
                        text: 'Crop Yield Progress Over Time',
                        color: '#e2e8f0',
                        font: { size: 14, weight: '600', family: "'Segoe UI', system-ui, sans-serif" },
                        padding: { bottom: 20 }
                    },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#94a3b8',
                        bodyColor: '#e2e8f0',
                        borderColor: '#334155',
                        borderWidth: 1,
                        padding: 12,
                        callbacks: {
                            label: ctx => '  ' + ctx.dataset.label + ': ' + (ctx.parsed.y ?? 0).toLocaleString() + ' kg'
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Yield (kg)',
                            color: '#94a3b8',
                            font: { size: 11 }
                        },
                        grid: { color: 'rgba(255,255,255,.06)' },
                        ticks: {
                            callback: val => val.toLocaleString() + ' kg',
                            color: '#94a3b8',
                            font: { size: 11 }
                        },
                        border: { color: 'rgba(255,255,255,.1)' }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Harvest Date',
                            color: '#94a3b8',
                            font: { size: 11 }
                        },
                        grid: { color: 'rgba(255,255,255,.04)' },
                        ticks: {
                            color: '#94a3b8',
                            font: { size: 11 },
                            maxRotation: 30
                        },
                        border: { color: 'rgba(255,255,255,.1)' }
                    }
                },
                animation: {
                    duration: 900,
                    easing: 'easeInOutCubic'
                }
            }
        });
    </script>
}
