@model FarmManagement.Web.Models.ViewModels.YieldAnalyticsViewModel

@{
    ViewData["Title"] = "Yield Analytics";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-graph-up-arrow"></i>
            </span>
            Yield Analytics
        </h1>
        <p>Harvest yield records, averages and crop-wise breakdown.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to Reports
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-graph-up"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#16a34a;font-size:1.3rem;">
                    @Model.TotalYield.ToString("N0") kg
                </div>
                <div class="stat-label">Total Yield (All Time)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-calculator"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#2563eb;font-size:1.3rem;">
                    @Model.AverageYield.ToString("N0") kg
                </div>
                <div class="stat-label">Average Yield Per Harvest</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe;color:#0284c7;">
                <i class="bi bi-basket"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#0284c7;">@Model.Records.Count()</div>
                <div class="stat-label">Total Harvest Records</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Records.Any())
{
    <!-- ── Chart Row: Bar + Doughnut ── -->
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="fm-card h-100">
                <div class="fm-card-header">
                    <span class="ch-title">
                        <i class="bi bi-bar-chart-fill" style="color:#2563eb;"></i>
                        Yield by Crop
                    </span>
                    <span style="font-size:.72rem;color:var(--fm-muted);">Total harvested (kg) per crop</span>
                </div>
                <div class="fm-card-body" style="padding:1.25rem;">
                    <canvas id="barChart" height="260"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="fm-card h-100">
                <div class="fm-card-header">
                    <span class="ch-title">
                        <i class="bi bi-pie-chart-fill" style="color:#7c3aed;"></i>
                        Crop Share
                    </span>
                    <span style="font-size:.72rem;color:var(--fm-muted);">Percentage of total yield</span>
                </div>
                <div class="fm-card-body d-flex align-items-center justify-content-center" style="padding:1.25rem;">
                    <canvas id="doughnutChart" height="260"></canvas>
                </div>
            </div>
        </div>
    </div>

    }

    <div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title">
            <i class="bi bi-table" style="color:#16a34a;"></i>
            Harvest Records
        </span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Records.Count() records</span>
    </div>
    @if (!Model.Records.Any())
    {
        <div class="empty-state">
            <i class="bi bi-basket"></i>
            <p>No harvest records found yet.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Crop</th>
                        <th>Field</th>
                        <th>Harvested Date</th>
                        <th>Expected (kg)</th>
                        <th>Actual (kg)</th>
                        <th>Variance</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        var expected = record.PlantingSchedule?.ExpectedYieldKg ?? 0;
                        var actual = record.ActualYieldKg;
                        var variance = actual - expected;
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@record.HarvestId</td>
                            <td style="font-weight:600;">@(record.PlantingSchedule?.Crop?.CropName ?? "—")</td>
                            <td>@(record.PlantingSchedule?.Field?.FieldName ?? "—")</td>
                            <td>@record.HarvestedDate.ToString("dd MMM yyyy")</td>
                            <td>@expected.ToString("N0") kg</td>
                            <td style="font-weight:700;color:#16a34a;">@actual.ToString("N0") kg</td>
                            <td>
                                @if (variance >= 0)
                                {
                                    <span class="badge-pill badge-green">+@variance.ToString("N0") kg</span>
                                }
                                else
                                {
                                    <span class="badge-pill badge-red">@variance.ToString("N0") kg</span>
                                }
                            </td>
                            <td>@(record.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const harvestRecords = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Records
                .OrderBy(r => r.HarvestedDate)
                .Select(r => new {
                    crop  = r.PlantingSchedule != null && r.PlantingSchedule.Crop  != null ? r.PlantingSchedule.Crop.CropName   : "Unknown",
                    field = r.PlantingSchedule != null && r.PlantingSchedule.Field != null ? r.PlantingSchedule.Field.FieldName  : "Unknown",
                    date  = r.HarvestedDate.ToString("dd MMM yy"),
                    yield = r.ActualYieldKg
                })
        ));

        if (harvestRecords.length > 0) {
            const colors = ['#2563eb','#16a34a','#f59e0b','#7c3aed','#dc2626','#0284c7','#ea580c','#34d399'];
            const bgColors = ['rgba(37,99,235,.7)','rgba(22,163,106,.7)','rgba(245,158,11,.7)','rgba(124,58,250,.7)','rgba(220,38,38,.7)','rgba(2,132,199,.7)','rgba(234,88,12,.7)','rgba(52,211,153,.7)'];
            const bgLight  = ['rgba(37,99,235,.12)','rgba(22,163,106,.12)','rgba(245,158,11,.12)','rgba(124,58,250,.12)','rgba(220,38,38,.12)','rgba(2,132,199,.12)','rgba(234,88,12,.12)','rgba(52,211,153,.12)'];

            // ── Aggregate by crop ──
            const cropMap = {};
            harvestRecords.forEach(r => { cropMap[r.crop] = (cropMap[r.crop] || 0) + r.yield; });
            const cropNames = Object.keys(cropMap);
            const cropTotals = Object.values(cropMap);

            // ═══  BAR CHART  ═══
            new Chart(document.getElementById('barChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: cropNames,
                    datasets: [{
                        label: 'Total Yield (kg)',
                        data: cropTotals,
                        backgroundColor: bgColors.slice(0, cropNames.length),
                        borderColor: colors.slice(0, cropNames.length),
                        borderWidth: 2,
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e293b', titleColor: '#94a3b8', bodyColor: '#e2e8f0',
                            borderColor: '#334155', borderWidth: 1, cornerRadius: 8, padding: 12,
                            callbacks: { label: ctx => '  ' + ctx.parsed.y.toLocaleString() + ' kg' }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,.06)' },
                            ticks: { callback: v => v.toLocaleString(), color: '#64748b', font: { size: 11 } },
                            border: { display: false }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#64748b', font: { size: 11, weight: '600' } },
                            border: { display: false }
                        }
                    },
                    animation: { duration: 1000, easing: 'easeOutQuart' }
                }
            });

            // ═══  DOUGHNUT CHART  ═══
            new Chart(document.getElementById('doughnutChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: cropNames,
                    datasets: [{
                        data: cropTotals,
                        backgroundColor: bgColors.slice(0, cropNames.length),
                        borderColor: '#fff',
                        borderWidth: 3,
                        hoverOffset: 12
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '62%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#475569', font: { size: 12, weight: '500' },
                                usePointStyle: true, pointStyle: 'circle', padding: 16
                            }
                        },
                        tooltip: {
                            backgroundColor: '#1e293b', titleColor: '#94a3b8', bodyColor: '#e2e8f0',
                            borderColor: '#334155', borderWidth: 1, cornerRadius: 8, padding: 12,
                            callbacks: {
                                label: ctx => {
                                    const total = ctx.dataset.data.reduce((a,b) => a+b, 0);
                                    const pct = ((ctx.parsed / total) * 100).toFixed(1);
                                    return '  ' + ctx.label + ': ' + ctx.parsed.toLocaleString() + ' kg (' + pct + '%)';
                                }
                            }
                        }
                    },
                    animation: { animateRotate: true, duration: 1200 }
                }
            });

                    }
                </script>
            }
