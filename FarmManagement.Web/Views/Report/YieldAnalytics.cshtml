@model FarmManagement.Web.Models.ViewModels.YieldAnalyticsViewModel

@{
    ViewData["Title"] = "Yield Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-graph-up-arrow"></i> Yield Analytics</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Reports
    </a>
</div>

<!-- ── Summary Cards ───────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-2 fw-bold text-success">
                @Model.TotalYield.ToString("N0") kg
            </div>
            <div class="text-muted small">Total Yield (All Time)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-2 fw-bold text-primary">
                @Model.AverageYield.ToString("N0") kg
            </div>
            <div class="text-muted small">Average Yield Per Harvest</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fs-2 fw-bold text-info">
                @Model.Records.Count()
            </div>
            <div class="text-muted small">Total Harvest Records</div>
        </div>
    </div>
</div>

<!-- ── Chart ──────────────────────────────────────────────────── -->
@if (Model.Records.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <i class="bi bi-bar-chart"></i> Yield by Crop
        </div>
        <div class="card-body">
            <canvas id="yieldChart" height="100"></canvas>
        </div>
    </div>
}

<!-- ── Records Table ──────────────────────────────────────────── -->
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-table"></i> Harvest Records
    </div>
    <div class="card-body">
        @if (!Model.Records.Any())
        {
            <p class="text-muted text-center">No harvest records found.</p>
        }
        else
        {
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Crop</th>
                        <th>Field</th>
                        <th>Harvested Date</th>
                        <th>Expected Yield (kg)</th>
                        <th>Actual Yield (kg)</th>
                        <th>Variance</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        var expected = record.PlantingSchedule?.ExpectedYieldKg ?? 0;
                        var actual = record.ActualYieldKg;
                        var variance = actual - expected;

                        <tr>
                            <td>@record.HarvestId</td>
                            <td>
                                @(record.PlantingSchedule?.Crop?.CropName ?? "-")
                            </td>
                            <td>
                                @(record.PlantingSchedule?.Field?.FieldName ?? "-")
                            </td>
                            <td>
                                @record.HarvestedDate.ToString("dd MMM yyyy")
                            </td>
                            <td>@expected.ToString("N0") kg</td>
                            <td class="fw-semibold text-success">
                                @actual.ToString("N0") kg
                            </td>
                            <td>
                                @if (variance >= 0)
                                {
                                    <span class="badge bg-success">
                                        +@variance.ToString("N0") kg
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        @variance.ToString("N0") kg
                                    </span>
                                }
                            </td>
                            <td>@(record.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- ── Chart.js Script ────────────────────────────────────────── -->
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const cropNames  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CropNames));
        const yieldValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.YieldValues));

        const ctx = document.getElementById('yieldChart').getContext('2d');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: cropNames,
        datasets: [{
        label: 'Actual Yield (kg)',
        data: yieldValues,
        backgroundColor: [
        'rgba(25,  135, 84,  0.7)',
        'rgba(13,  110, 253, 0.7)',
        'rgba(255, 193, 7,   0.7)',
        'rgba(220, 53,  69,  0.7)',
        'rgba(13,  202, 240, 0.7)',
        'rgba(108, 117, 125, 0.7)'
        ],
        borderColor: [
        'rgba(25,  135, 84,  1)',
        'rgba(13,  110, 253, 1)',
        'rgba(255, 193, 7,   1)',
        'rgba(220, 53,  69,  1)',
        'rgba(13,  202, 240, 1)',
        'rgba(108, 117, 125, 1)'
        ],
        borderWidth: 1
        }]
        },
        options: {
        responsive: true,
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        label: ctx => ctx.parsed.y.toLocaleString() + ' kg'
        }
        }
        },
        scales: {
        y: {
        beginAtZero: true,
        ticks: {
        callback: val => val.toLocaleString() + ' kg'
        }
        }
        }
        }
        });
    </script>
}