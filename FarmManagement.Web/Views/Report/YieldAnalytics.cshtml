@model FarmManagement.Web.Models.ViewModels.YieldAnalyticsViewModel

@{
    ViewData["Title"] = "Yield Analytics";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-graph-up-arrow"></i>
            </span>
            Yield Analytics
        </h1>
        <p>Harvest yield records, trends, crop-wise totals and performance breakdown.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to Reports
    </a>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-graph-up"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#16a34a;font-size:1.25rem;">
                    @Model.TotalYield.ToString("N0") kg
                </div>
                <div class="stat-label">Total Yield (All Time)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-calculator"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#2563eb;font-size:1.25rem;">
                    @Model.AverageYield.ToString("N0") kg
                </div>
                <div class="stat-label">Average Yield Per Harvest</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe;color:#0284c7;">
                <i class="bi bi-basket"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#0284c7;">@Model.Records.Count()</div>
                <div class="stat-label">Total Harvest Records</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Records.Any())
{
    <!-- ── Row 1: Yield Trend Line + Doughnut ── -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="fm-card h-100">
                <div class="fm-card-header">
                    <span class="ch-title">
                        <i class="bi bi-graph-up-arrow" style="color:#16a34a;"></i>
                        Yield Trend Over Time
                    </span>
                    <span style="font-size:.72rem;color:var(--fm-muted);">Actual yield per harvest event (kg)</span>
                </div>
                <div style="padding:1rem 1.25rem 1.25rem;">
                    <canvas id="trendChart" height="230"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="fm-card h-100">
                <div class="fm-card-header">
                    <span class="ch-title">
                        <i class="bi bi-pie-chart-fill" style="color:#7c3aed;"></i>
                        Crop Share
                    </span>
                    <span style="font-size:.72rem;color:var(--fm-muted);">% of total yield</span>
                </div>
                <div style="padding:1rem 1.25rem 1.25rem;display:flex;flex-direction:column;align-items:center;">
                    <canvas id="doughnutChart" height="210"></canvas>
                    <div id="doughnutLegend" style="display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center;margin-top:.85rem;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Row 2: Bar Chart ── -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="fm-card">
                <div class="fm-card-header">
                    <span class="ch-title">
                        <i class="bi bi-bar-chart-fill" style="color:#2563eb;"></i>
                        Total Yield by Crop
                    </span>
                    <span style="font-size:.72rem;color:var(--fm-muted);">Cumulative harvested kg per crop</span>
                </div>
                <div style="padding:1rem 1.25rem 1.25rem;">
                    <canvas id="barChart" height="180"></canvas>
                </div>
            </div>
        </div>
    </div>
}

<!-- Harvest Records Table -->
<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title">
            <i class="bi bi-table" style="color:#16a34a;"></i>
            Harvest Records
        </span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Records.Count() records</span>
    </div>
    @if (!Model.Records.Any())
    {
        <div class="empty-state">
            <i class="bi bi-basket"></i>
            <p>No harvest records found yet.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Crop</th>
                        <th>Field</th>
                        <th>Harvested Date</th>
                        <th>Expected (kg)</th>
                        <th>Actual (kg)</th>
                        <th>Variance</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var sno = 1; }
                    @foreach (var record in Model.Records.OrderByDescending(r => r.HarvestedDate))
                    {
                        var expected = record.PlantingSchedule?.ExpectedYieldKg ?? 0;
                        var actual   = record.ActualYieldKg;
                        var variance = actual - expected;
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@(sno++)</td>
                            <td style="font-weight:600;">@(record.PlantingSchedule?.Crop?.CropName ?? "—")</td>
                            <td>@(record.PlantingSchedule?.Field?.FieldName ?? "—")</td>
                            <td>@record.HarvestedDate.ToString("dd MMM yyyy")</td>
                            <td>@expected.ToString("N0") kg</td>
                            <td style="font-weight:700;color:#16a34a;">@actual.ToString("N0") kg</td>
                            <td>
                                @if (variance >= 0)
                                {
                                    <span class="badge-pill badge-green">+@variance.ToString("N0") kg</span>
                                }
                                else
                                {
                                    <span class="badge-pill badge-red">@variance.ToString("N0") kg</span>
                                }
                            </td>
                            <td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@(record.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(function () {
    const records = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Records
            .OrderBy(r => r.HarvestedDate)
            .Select(r => new {
                crop     = r.PlantingSchedule?.Crop?.CropName   ?? "Unknown",
                field    = r.PlantingSchedule?.Field?.FieldName ?? "Unknown",
                date     = r.HarvestedDate.ToString("dd MMM yy"),
                expected = r.PlantingSchedule?.ExpectedYieldKg ?? 0,
                actual   = r.ActualYieldKg
            })
    ));

    if (!records || records.length === 0) return;

    const palette = [
        '#2563eb','#16a34a','#f59e0b','#7c3aed','#dc2626',
        '#0284c7','#ea580c','#34d399','#f43f5e','#06b6d4'
    ];
    const paletteA = palette.map(c => c + 'bb');

    const tooltipBase = {
        backgroundColor: '#1e293b', titleColor: '#94a3b8', bodyColor: '#e2e8f0',
        borderColor: '#334155', borderWidth: 1, cornerRadius: 8, padding: 12
    };

    // ── Aggregate by crop ──────────────────────────────────────────
    const cropMap = {};
    records.forEach(r => { cropMap[r.crop] = (cropMap[r.crop] || 0) + r.actual; });
    const cropNames  = Object.keys(cropMap);
    const cropTotals = Object.values(cropMap);

    // ── 1. TREND LINE CHART ────────────────────────────────────────
    const trendCtx = document.getElementById('trendChart');
    if (trendCtx) {
        // assign a stable colour per crop
        const cropColor = {};
        cropNames.forEach((n, i) => cropColor[n] = palette[i % palette.length]);

        // build one dataset per crop so each line has its own colour
        const datasets = cropNames.map((crop, i) => {
            const pts = records.filter(r => r.crop === crop);
            return {
                label: crop,
                data: records.map(r => r.crop === crop ? r.actual : null),
                borderColor: palette[i % palette.length],
                backgroundColor: palette[i % palette.length] + '18',
                pointBackgroundColor: palette[i % palette.length],
                pointRadius: 5,
                pointHoverRadius: 7,
                borderWidth: 2.5,
                tension: 0.38,
                fill: false,
                spanGaps: false
            };
        });

        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: records.map(r => r.date + ' · ' + r.crop),
                datasets
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#475569', font: { size: 11 }, usePointStyle: true, pointStyle: 'circle', padding: 14 }
                    },
                    tooltip: {
                        ...tooltipBase,
                        callbacks: { label: c => c.parsed.y !== null ? '  ' + c.dataset.label + ': ' + c.parsed.y.toLocaleString() + ' kg' : null }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b', font: { size: 10 }, maxRotation: 40 },
                        border: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,.06)' },
                        ticks: { callback: v => v.toLocaleString() + ' kg', color: '#64748b', font: { size: 11 } },
                        border: { display: false }
                    }
                },
                animation: { duration: 1000, easing: 'easeOutQuart' }
            }
        });
    }

    // ── 2. BAR CHART (Total by Crop) ──────────────────────────────
    const barCtx = document.getElementById('barChart');
    if (barCtx) {
        new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: cropNames,
                datasets: [{
                    label: 'Total Yield (kg)',
                    data: cropTotals,
                    backgroundColor: paletteA.slice(0, cropNames.length),
                    borderColor:     palette.slice(0, cropNames.length),
                    borderWidth: 2, borderRadius: 8, borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        ...tooltipBase,
                        callbacks: { label: c => '  ' + c.parsed.y.toLocaleString() + ' kg' }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,.06)' },
                        ticks: { callback: v => v.toLocaleString(), color: '#64748b', font: { size: 11 } },
                        border: { display: false }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#374151', font: { size: 12, weight: '600' } },
                        border: { display: false }
                    }
                },
                animation: { duration: 1000, easing: 'easeOutQuart' }
            }
        });
    }

    // ── 3. DOUGHNUT (Crop Share) ───────────────────────────────────
    const donutCtx = document.getElementById('doughnutChart');
    if (donutCtx) {
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: cropNames,
                datasets: [{
                    data: cropTotals,
                    backgroundColor: paletteA.slice(0, cropNames.length),
                    borderColor: '#fff',
                    borderWidth: 3,
                    hoverOffset: 12
                }]
            },
            options: {
                responsive: true, cutout: '62%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        ...tooltipBase,
                        callbacks: {
                            label: c => {
                                const total = c.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = ((c.parsed / total) * 100).toFixed(1);
                                return '  ' + c.label + ': ' + c.parsed.toLocaleString() + ' kg (' + pct + '%)';
                            }
                        }
                    }
                },
                animation: { animateRotate: true, duration: 1200 }
            }
        });

        // custom legend
        const leg = document.getElementById('doughnutLegend');
        if (leg) cropNames.forEach((n, i) => {
            leg.innerHTML += `<span style="font-size:.72rem;display:flex;align-items:center;gap:.3rem;">
                <span style="width:10px;height:10px;border-radius:50%;background:${paletteA[i]};display:inline-block;"></span>${n}</span>`;
        });
    }
})();
</script>
}
