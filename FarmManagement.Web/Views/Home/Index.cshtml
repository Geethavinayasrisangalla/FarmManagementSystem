@model FarmManagement.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-speedometer2"></i>
            </span>
            Farm Dashboard
        </h1>
        <p>Overview of your farm operations — @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Field" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-grid-3x3-gap"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#16a34a;">@Model.TotalFields</div>
                <div class="stat-label">Total Fields</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Crop" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-flower1"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#2563eb;">@Model.TotalCrops</div>
                <div class="stat-label">Total Crops</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Pest" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:#fee2e2;color:#dc2626;">
                <i class="bi bi-bug"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#dc2626;">@Model.ActivePestIncidents</div>
                <div class="stat-label">Active Pest Incidents</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Resource" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:#fef9c3;color:#ca8a04;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#ca8a04;">@Model.LowStockResources</div>
                <div class="stat-label">Low Stock Resources</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Schedule" asp-action="HarvestList" class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe;color:#0284c7;">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#0284c7;">@Model.UpcomingHarvests</div>
                <div class="stat-label">Upcoming Harvests (30 days)</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Report" asp-action="YieldAnalytics" class="stat-card">
            <div class="stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div>
                <div class="stat-value" style="color:#16a34a;font-size:1.25rem;">
                    @Model.TotalYieldThisSeason.ToString("N0") kg
                </div>
                <div class="stat-label">Total Yield This Year</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-calendar3" style="color:#2563eb;"></i>
                    Upcoming Schedules
                </span>
                <a asp-controller="Schedule" asp-action="Index"
                   class="btn-fm btn-outline-fm btn-sm-fm">View All</a>
            </div>
            @if (Model.RecentSchedules == null || !Model.RecentSchedules.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p>No upcoming schedules.</p>
                </div>
            }
            else
            {
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>Crop</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSchedules)
                        {
                            <tr>
                                <td style="font-weight:600;">@(s.Crop?.CropName ?? "Unknown")</td>
                                <td>@s.ScheduledDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge-pill badge-blue">Scheduled</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-bug" style="color:#dc2626;"></i>
                    Active Pest Alerts
                </span>
                <a asp-controller="Pest" asp-action="Index"
                   class="btn-fm btn-outline-fm btn-sm-fm">View All</a>
            </div>
            @if (Model.RecentPestAlerts == null || !Model.RecentPestAlerts.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-check-circle"></i>
                    <p>No active pest alerts.</p>
                </div>
            }
            else
            {
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>Pest</th>
                            <th>Crop</th>
                            <th>Reported</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.RecentPestAlerts)
                        {
                            <tr>
                                <td style="font-weight:600;">@p.PestName</td>
                                <td>@(p.Crop?.CropName ?? "Unknown")</td>
                                <td>
                                    <span class="badge-pill badge-red">Active</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
