@model FarmManagement.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var hour     = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good Morning" : hour < 17 ? "Good Afternoon" : "Good Evening";
    var greetIcon= hour < 12 ? "bi-sunrise" : hour < 17 ? "bi-sun" : "bi-moon-stars";
    var userName = User.Identity?.Name ?? "Farmer";
}

<!-- ══ WELCOME BANNER ══ -->
<div class="welcome-banner mb-4" style="padding:0;overflow:hidden;border-radius:20px;">
    <div style="display:flex;align-items:stretch;min-height:160px;">

        <!-- Left: text content -->
        <div style="flex:1;padding:1.8rem 2rem;position:relative;z-index:2;">
            <div style="font-size:.72rem;font-weight:700;color:#4ade80;text-transform:uppercase;letter-spacing:.12em;margin-bottom:.4rem;display:flex;align-items:center;gap:.5rem;">
                <i class="bi @greetIcon"></i> @greeting
            </div>
            <div style="font-size:1.6rem;font-weight:900;color:#fff;letter-spacing:-.03em;line-height:1.15;margin-bottom:.5rem;">
                @userName
            </div>
            <div style="font-size:.8rem;color:rgba(255,255,255,.5);margin-bottom:1.3rem;">
                <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </div>
            <!-- Quick stats row -->
            <div style="display:flex;gap:1.5rem;flex-wrap:wrap;">
                <div>
                    <div style="font-size:1.4rem;font-weight:900;color:#fff;line-height:1;">@Model.TotalFields</div>
                    <div style="font-size:.65rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.07em;">Fields</div>
                </div>
                <div style="width:1px;background:rgba(255,255,255,.1);"></div>
                <div>
                    <div style="font-size:1.4rem;font-weight:900;color:#fff;line-height:1;">@Model.TotalCrops</div>
                    <div style="font-size:.65rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.07em;">Crops</div>
                </div>
                <div style="width:1px;background:rgba(255,255,255,.1);"></div>
                <div>
                    <div style="font-size:1.4rem;font-weight:900;color:#4ade80;line-height:1;">@Model.TotalYieldThisSeason.ToString("N0") kg</div>
                    <div style="font-size:.65rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.07em;">Total Yield</div>
                </div>
                @if (Model.ActivePestIncidents > 0)
                {
                    <div style="width:1px;background:rgba(255,255,255,.1);"></div>
                    <div>
                        <div style="font-size:1.4rem;font-weight:900;color:#f87171;line-height:1;">@Model.ActivePestIncidents</div>
                        <div style="font-size:.65rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.07em;">Pest Alerts</div>
                    </div>
                }
            </div>
        </div>

        <!-- Right: SVG farm scene panel -->
        <div style="flex:0 0 300px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;" class="d-none d-lg-flex">
            <!-- gradient overlay blend -->
            <div style="position:absolute;left:0;top:0;bottom:0;width:60px;background:linear-gradient(90deg,#071a09,transparent);z-index:1;"></div>
            <svg viewBox="0 0 300 160" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;object-fit:cover;">
                <defs>
                    <linearGradient id="wbG" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0a2010"/>
                        <stop offset="100%" stop-color="#143d18"/>
                    </linearGradient>
                </defs>
                <rect width="300" height="160" fill="url(#wbG)"/>
                <!-- Hills -->
                <path d="M0 110 Q50 85 100 95 Q150 78 200 92 Q250 80 300 95 L300 160 L0 160Z" fill="#166534" opacity=".8"/>
                <path d="M0 120 Q60 100 120 108 Q180 96 240 106 Q270 100 300 108 L300 160 L0 160Z" fill="#15803d" opacity=".9"/>
                <!-- Trees -->
                <g opacity=".9">
                    <rect x="22" y="90" width="4" height="22" fill="#78350f"/>
                    <ellipse cx="24" cy="83" rx="12" ry="14" fill="#166534"/>
                    <ellipse cx="24" cy="76" rx="8" ry="10" fill="#16a34a"/>
                    <rect x="48" y="93" width="3" height="18" fill="#78350f"/>
                    <ellipse cx="49.5" cy="87" rx="10" ry="12" fill="#166534"/>
                    <ellipse cx="49.5" cy="81" rx="7" ry="9" fill="#16a34a"/>
                </g>
                <!-- Barn -->
                <rect x="110" y="78" width="40" height="34" rx="2" fill="#7f1d1d" opacity=".9"/>
                <polygon points="106,78 154,78 130,60" fill="#991b1b"/>
                <rect x="122" y="95" width="14" height="17" rx="1" fill="#450a0a" opacity=".8"/>
                <rect x="113" y="83" width="9" height="9" rx="1" fill="#fbbf24" opacity=".35"/>
                <rect x="140" y="83" width="9" height="9" rx="1" fill="#fbbf24" opacity=".35"/>
                <!-- Silo -->
                <rect x="156" y="85" width="16" height="27" rx="2" fill="#374151" opacity=".8"/>
                <ellipse cx="164" cy="85" rx="8" ry="4" fill="#4b5563"/>
                <!-- Windmill -->
                <rect x="240" y="70" width="4" height="44" fill="#6b7280" opacity=".7"/>
                <g transform="translate(242,80)" opacity=".7">
                    <ellipse rx="2.5" ry="14" fill="#9ca3af" transform="rotate(20)"/>
                    <ellipse rx="2.5" ry="14" fill="#9ca3af" transform="rotate(92)"/>
                    <ellipse rx="2.5" ry="14" fill="#9ca3af" transform="rotate(164)"/>
                    <ellipse rx="2.5" ry="14" fill="#9ca3af" transform="rotate(236)"/>
                    <circle r="3.5" fill="#d1d5db"/>
                </g>
                <!-- Crops -->
                <g stroke="#4ade80" stroke-width="1.2" opacity=".55">
                    <line x1="175" y1="148" x2="175" y2="130"/><ellipse cx="175" cy="128" rx="3" ry="5" fill="#22c55e" opacity=".8"/>
                    <line x1="188" y1="145" x2="188" y2="128"/><ellipse cx="188" cy="126" rx="3" ry="5" fill="#22c55e" opacity=".8"/>
                    <line x1="200" y1="143" x2="200" y2="126"/><ellipse cx="200" cy="124" rx="3" ry="5" fill="#4ade80" opacity=".9"/>
                    <line x1="213" y1="145" x2="213" y2="128"/><ellipse cx="213" cy="126" rx="3" ry="5" fill="#22c55e" opacity=".8"/>
                </g>
                <!-- Stars -->
                <g fill="#fff" opacity=".4">
                    <circle cx="30" cy="20" r="1"/><circle cx="80" cy="12" r="1.2"/><circle cx="160" cy="18" r="1"/>
                    <circle cx="220" cy="8" r="1.1"/><circle cx="270" cy="22" r="1"/><circle cx="50" cy="40" r=".9"/>
                </g>
                <!-- Moon -->
                <circle cx="260" cy="30" r="16" fill="#1e3a5f" opacity=".7"/>
                <circle cx="268" cy="24" r="13" fill="#0a2010"/>
                <!-- Tractor small -->
                <g transform="translate(68,120)" opacity=".8">
                    <rect x="0" y="5" width="28" height="12" rx="3" fill="#dc2626"/>
                    <rect x="6" y="1" width="13" height="10" rx="2" fill="#ef4444"/>
                    <circle cx="5"  cy="17" r="5.5" fill="#1f2937" stroke="#374151" stroke-width="1"/>
                    <circle cx="5"  cy="17" r="2.5" fill="#374151"/>
                    <circle cx="23" cy="17" r="4"   fill="#1f2937" stroke="#374151" stroke-width="1"/>
                    <circle cx="23" cy="17" r="2"   fill="#374151"/>
                </g>
            </svg>
        </div>

    </div>
</div>

<!-- ══ QUICK ACTION BUTTONS ══ -->
<div style="display:flex;gap:.65rem;flex-wrap:wrap;margin-bottom:1.5rem;">
    <a asp-controller="Crop" asp-action="Create" class="btn-fm btn-primary-fm btn-sm-fm">
        <i class="bi bi-plus-circle"></i> Add Crop
    </a>
    <a asp-controller="Field" asp-action="Create" class="btn-fm btn-outline-fm btn-sm-fm">
        <i class="bi bi-map"></i> Add Field
    </a>
    <a asp-controller="Schedule" asp-action="Create" class="btn-fm btn-outline-fm btn-sm-fm">
        <i class="bi bi-calendar-plus"></i> Schedule
    </a>
    <a asp-controller="Pest" asp-action="Create" class="btn-fm btn-outline-fm btn-sm-fm">
        <i class="bi bi-bug"></i> Report Pest
    </a>
    <a asp-controller="Report" asp-action="YieldAnalytics" class="btn-fm btn-outline-fm btn-sm-fm" style="margin-left:auto;">
        <i class="bi bi-graph-up-arrow"></i> Analytics
    </a>
</div>

<!-- ══ KPI STAT CARDS ══ -->
<div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Field" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#dcfce7,#bbf7d0);box-shadow:0 4px 12px rgba(22,163,74,.2);">
                <i class="bi bi-map" style="color:#15803d;"></i>
            </div>
            <div class="stat-body">
                <div class="stat-value text-grad-green">@Model.TotalFields</div>
                <div class="stat-label">Total Fields</div>
                <div class="stat-trend up"><i class="bi bi-check-circle"></i> All active</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Crop" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#dbeafe,#bfdbfe);box-shadow:0 4px 12px rgba(37,99,235,.18);">
                <i class="bi bi-flower1" style="color:#1d4ed8;"></i>
            </div>
            <div class="stat-body">
                <div class="stat-value" style="color:var(--blue);">@Model.TotalCrops</div>
                <div class="stat-label">Total Crops</div>
                <div class="stat-trend up"><i class="bi bi-arrow-up-right"></i> Growing</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Pest" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#fee2e2,#fecaca);box-shadow:0 4px 12px rgba(220,38,38,.18);">
                <i class="bi bi-bug" style="color:#b91c1c;"></i>
            </div>
            <div class="stat-body">
                <div class="stat-value" style="color:var(--red);">@Model.ActivePestIncidents</div>
                <div class="stat-label">Active Pest Incidents</div>
                @if (Model.ActivePestIncidents > 0)
                {
                    <div class="stat-trend down"><i class="bi bi-exclamation-triangle"></i> Needs attention</div>
                }
                else
                {
                    <div class="stat-trend up"><i class="bi bi-shield-check"></i> All clear</div>
                }
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Resource" asp-action="Index" class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#fef9c3,#fef08a);box-shadow:0 4px 12px rgba(202,138,4,.18);">
                <i class="bi bi-boxes" style="color:#a16207;"></i>
            </div>
            <div class="stat-body">
                <div class="stat-value" style="color:var(--yellow);">@Model.LowStockResources</div>
                <div class="stat-label">Low Stock Resources</div>
                @if (Model.LowStockResources > 0)
                {
                    <div class="stat-trend down"><i class="bi bi-cart-x"></i> Restock needed</div>
                }
                else
                {
                    <div class="stat-trend up"><i class="bi bi-cart-check"></i> Stock healthy</div>
                }
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Schedule" asp-action="HarvestList" class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#e0f2fe,#bae6fd);box-shadow:0 4px 12px rgba(2,132,199,.18);">
                <i class="bi bi-calendar-check" style="color:#0369a1;"></i>
            </div>
            <div class="stat-body">
                <div class="stat-value" style="color:#0284c7;">@Model.UpcomingHarvests</div>
                <div class="stat-label">Upcoming Harvests</div>
                <div class="stat-trend up"><i class="bi bi-clock-history"></i> Next 30 days</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Report" asp-action="YieldAnalytics" class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#f3e8ff,#e9d5ff);box-shadow:0 4px 12px rgba(124,58,237,.18);">
                <i class="bi bi-graph-up-arrow" style="color:#6d28d9;"></i>
            </div>
            <div class="stat-body">
                <div class="stat-value" style="font-size:1.25rem;color:#7c3aed;">
                    @Model.TotalYieldThisSeason.ToString("N0") kg
                </div>
                <div class="stat-label">Total Yield This Year</div>
                <div class="stat-trend up"><i class="bi bi-bar-chart-line"></i> View analytics</div>
            </div>
        </a>
    </div>

</div>

<!-- ══ ACTIVITY CARDS ══ -->
<div class="row g-4">

    <!-- Upcoming Schedules -->
    <div class="col-lg-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-calendar3" style="color:var(--blue);"></i>
                    Upcoming Schedules
                </span>
                <a asp-controller="Schedule" asp-action="Index" class="btn-fm btn-outline-fm btn-sm-fm">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            @if (Model.RecentSchedules == null || !Model.RecentSchedules.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p>No upcoming schedules found.</p>
                </div>
            }
            else
            {
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>Crop</th>
                            <th>Scheduled Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSchedules)
                        {
                            <tr>
                                <td>
                                    <span style="display:flex;align-items:center;gap:.55rem;">
                                        <span class="status-dot status-dot-green"></span>
                                        <span style="font-weight:700;">@(s.Crop?.CropName ?? "Unknown")</span>
                                    </span>
                                </td>
                                <td style="color:var(--muted);font-size:.82rem;">
                                    <i class="bi bi-calendar2 me-1" style="color:#2563eb;opacity:.6;"></i>
                                    @s.ScheduledDate.ToString("dd MMM yyyy")
                                </td>
                                <td><span class="badge-pill badge-blue">Scheduled</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Active Pest Alerts -->
    <div class="col-lg-6">
        <div class="fm-card h-100">
            <div class="fm-card-header">
                <span class="ch-title">
                    <i class="bi bi-shield-exclamation" style="color:var(--red);"></i>
                    Pest Alerts
                    @if (Model.ActivePestIncidents > 0)
                    {
                        <span class="badge-pill badge-red ms-1">@Model.ActivePestIncidents active</span>
                    }
                </span>
                <a asp-controller="Pest" asp-action="Index" class="btn-fm btn-outline-fm btn-sm-fm">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            @if (Model.RecentPestAlerts == null || !Model.RecentPestAlerts.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-shield-check" style="color:var(--green);background:var(--green-lt);border-color:var(--green-md);opacity:1;"></i>
                    <p style="color:var(--green);font-weight:600;">No active pest alerts!</p>
                    <p style="color:var(--muted);font-size:.78rem;margin-top:.25rem;">Your farm is healthy.</p>
                </div>
            }
            else
            {
                <table class="fm-table">
                    <thead>
                        <tr>
                            <th>Pest Name</th>
                            <th>Affected Crop</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.RecentPestAlerts)
                        {
                            <tr>
                                <td>
                                    <span style="display:flex;align-items:center;gap:.55rem;">
                                        <span class="status-dot status-dot-red"></span>
                                        <span style="font-weight:700;">@p.PestName</span>
                                    </span>
                                </td>
                                <td style="color:var(--muted);font-size:.82rem;">
                                    <i class="bi bi-flower1 me-1" style="color:#16a34a;opacity:.7;"></i>
                                    @(p.Crop?.CropName ?? "Unknown")
                                </td>
                                <td><span class="badge-pill badge-red">Active</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>
