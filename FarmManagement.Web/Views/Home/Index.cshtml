@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section d-flex align-items-center justify-content-center">
    <div class="overlay"></div>
    <div class="content-box text-center text-white p-5 shadow-lg">
        <h1 class="display-1 fw-bold mb-3">🌱 FarmAdmin</h1>
        <p class="lead mb-4 fs-3">Precision Agriculture & Field Management System</p>
        <hr class="bg-white border-2 border-top border-white opacity-50 mb-4">
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-action="Index" asp-controller="Crop" class="btn btn-success btn-lg px-4 gap-3 fw-bold">Open Crop Registry</a>
            <a asp-controller="Field" asp-action="Index" class="btn btn-outline-light btn-lg px-4 fw-bold">View Field Mapping</a>
        </div>
    </div>
</div>

<style>
    /* 1. Remove padding from the default container so the image hits the edges */
    main.container {
        max-width: 100% !important;
        padding: 0 !important;
    }

    /* 2. Style the main wrapper/hero section */
    .hero-section {
        /* Set your new background image URL */
        background-image: url('https://tse2.mm.bing.net/th/id/OIP.QHPUN4-tiVhg7iKF_t86dAHaEa?rs=1&pid=ImgDetMain&o=7&rm=3');
        /* Ensure the image covers the whole area without stretching weirdly */
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        /* Set the height. You can use 100vh for full screen minus the nav/footer */
        height: 85vh;
        position: relative;
        display: flex;
        align-items: center; /* Center vertically */
        justify-content: center; /* Center horizontally */
        /* Keep these for polish */
        border-radius: 15px;
        overflow: hidden;
        margin-top: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

        /* 3. This dark overlay makes the white text readable on ANY image */
        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.45); /* Adjusted for readability */
            z-index: 1;
        }

        /* 4. This ensures your content stays on top of the overlay */
        .hero-section .container {
            position: relative;
            z-index: 2;
        }
</style>