@model FarmManagement.Models.Resource
@{
    ViewData["Title"] = "Allocate Resource";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-semibold">Allocate Resource</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Back to Inventory</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="mb-4 p-3 bg-light rounded">
                <h5 class="mb-1">@Model.Name</h5>
                <span class="text-muted">Available: <strong>@Model.Quantity @Model.Unit</strong></span>
            </div>

            <form asp-action="Allocate" method="post">
                <input type="hidden" name="resourceId" value="@Model.ResourceId" />
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Field</label>
                    <select name="fieldId" class="form-select" required>
                        <option value="">-- Select Field --</option>
                        @foreach (var field in ViewBag.Fields as IEnumerable<FarmManagement.Models.Field>)
                        {
                            <option value="@field.FieldId">@field.FieldName (@field.Location)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Quantity to Allocate (@Model.Unit)</label>
                    <input type="number" name="qty" class="form-control" step="0.01"
                           min="0.01" max="@Model.Quantity" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Notes (optional)</label>
                    <textarea name="notes" class="form-control" rows="3"
                              placeholder="e.g. Applied to north section"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Allocate</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>