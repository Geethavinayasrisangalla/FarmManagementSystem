@model FarmManagement.Web.Models.ViewModels.InventoryViewModel
@{
    ViewData["Title"] = "Add Resource";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#ffedd5;color:#ea580c;">
                <i class="bi bi-box-seam"></i>
            </span>
            Add Resource
        </h1>
        <p>Fill in the details below to add a new resource to inventory.</p>
    </div>
    <a asp-action="Index" class="btn-fm btn-outline-fm">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title"><i class="bi bi-box-seam" style="color:#ea580c;"></i> Resource Details</span>
    </div>
    <div class="fm-card-body fm-form">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="fm-alert fm-alert-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <select asp-for="Name" class="form-select">
                        <option value="">-- Select Resource Name --</option>
                        <option value="Tractor">Tractor</option>
                        <option value="Harvester">Harvester</option>
                        <option value="Plough">Plough</option>
                        <option value="Seed Drill">Seed Drill</option>
                        <option value="Rotavator">Rotavator</option>
                        <option value="Cultivator">Cultivator</option>
                        <option value="Harrow">Harrow</option>
                        <option value="Bullock Cart">Bullock Cart</option>
                        <option value="Trailer">Trailer</option>
                        <option value="Farm Wagon">Farm Wagon</option>
                        <option value="Sprayer">Sprayer</option>
                        <option value="Combine Harvester">Combine Harvester</option>
                        <option value="Thresher">Thresher</option>
                        <option value="Paddy Transplanter">Paddy Transplanter</option>
                        <option value="Power Tiller">Power Tiller</option>
                        <option value="Water Tanker Truck">Water Tanker Truck</option>
                        <option value="Pickup Truck">Pickup Truck</option>
                        <option value="Mini Truck">Mini Truck</option>
                        <option value="ATV">ATV</option>
                        <option value="Irrigation Pump">Irrigation Pump</option>
                    </select>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" class="form-select"
                            asp-items="Html.GetEnumSelectList<FarmManagement.Web.Models.Enums.ResourceType>()">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" placeholder="e.g. 100" />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Unit" class="form-label"></label>
                    <input asp-for="Unit" class="form-control" placeholder="e.g. kg, L, units" />
                    <span asp-validation-for="Unit" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn-fm btn-primary-fm">
                    <i class="bi bi-plus-circle"></i> Add Resource
                </button>
                <a asp-action="Index" class="btn-fm btn-outline-fm">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
