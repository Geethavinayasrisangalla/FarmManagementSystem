@model IEnumerable<FarmManagement.Models.Resource>
@{
    ViewData["Title"] = "Inventory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-semibold">Inventory Management</h2>
        <a asp-action="Create" class="btn btn-success">+ Add Resource</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Unit</th>
                        <th>Last Updated</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Type</td>
                            <td>@item.Quantity</td>
                            <td>@item.Unit</td>
                            <td>@item.LastUpdated.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.Quantity <= 10)
                                {
                                    <span class="badge bg-danger">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ResourceId"
                                   class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.ResourceId"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Allocate" asp-route-id="@item.ResourceId"
                                   class="btn btn-sm btn-outline-warning">Allocate</a>
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this resource?')">
                                    <input type="hidden" name="id" value="@item.ResourceId" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No resources found. Add one to get started.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>