@model IEnumerable<FarmManagement.Web.Models.Entities.PlantingSchedule>

@{
    ViewData["Title"] = "Planting Schedules";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="bi bi-calendar3"></i>
            </span>
            Planting Schedules
        </h1>
        <p>Plan and track crop planting and harvest activities.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("FieldSupervisor"))
    {
        <a asp-action="Create" class="btn-fm btn-primary-fm">
            <i class="bi bi-plus-circle"></i> New Schedule
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="fm-alert fm-alert-success mb-3">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="fm-alert fm-alert-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<form method="get" class="mb-3 d-flex gap-2" style="max-width:400px;">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search schedules..." />
    <button type="submit" class="btn-fm btn-primary-fm"><i class="bi bi-search"></i></button>
    @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
    {
        <a asp-action="Index" class="btn-fm btn-outline-fm"><i class="bi bi-x-lg"></i></a>
    }
</form>

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title">
            <i class="bi bi-table" style="color:#2563eb;"></i>
            All Schedules
        </span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Count() records</span>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar3"></i>
            <p>No schedules found. Create your first planting schedule.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Crop</th>
                        <th>Field</th>
                        <th>Scheduled Date</th>
                        <th>Expected Yield</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var schBadge = item.Status switch {
                            "Scheduled"  => "badge-blue",
                            "Completed"  => "badge-green",
                            "Cancelled"  => "badge-gray",
                            _            => "badge-yellow"
                        };
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@item.ScheduleId</td>
                            <td style="font-weight:600;">@(item.Crop?.CropName ?? "—")</td>
                            <td>@(item.Field?.FieldName ?? "—")</td>
                            <td>@item.ScheduledDate.ToString("dd MMM yyyy")</td>
                            <td>@item.ExpectedYieldKg kg</td>
                            <td>
                                <span class="badge-pill @schBadge">@item.Status</span>
                            </td>
                            <td style="max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @(item.Notes ?? "—")
                            </td>
                            <td>
                                <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
                                    <a asp-action="Details" asp-route-id="@item.ScheduleId"
                                       class="btn-fm btn-info-fm btn-sm-fm">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (item.Status == "Scheduled")
                                    {
                                        <a asp-action="RecordHarvest" asp-route-id="@item.ScheduleId"
                                           class="btn-fm btn-primary-fm btn-sm-fm">
                                            <i class="bi bi-basket"></i> Harvest
                                        </a>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("FieldSupervisor"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.ScheduleId"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this schedule?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-fm btn-danger-fm btn-sm-fm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
