@model IEnumerable<FarmManagement.Web.Models.Entities.PlantingSchedule>

@{
    ViewData["Title"] = "Planting Schedules";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-calendar3"></i> Planting Schedules</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> New Schedule
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-success">
                <tr>
                    <th>#</th>
                    <th>Crop</th>
                    <th>Field</th>
                    <th>Scheduled Date</th>
                    <th>Expected Yield (kg)</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            No schedules found.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ScheduleId</td>
                        <td>@(item.Crop?.CropName ?? "-")</td>
                        <td>@(item.Field?.FieldName ?? "-")</td>
                        <td>@item.ScheduledDate.ToString("dd MMM yyyy")</td>
                        <td>@item.ExpectedYieldKg kg</td>
                        <td>
                            <span class="badge
                                @(item.Status == "Scheduled" ? "bg-primary" :
                                                                    item.Status == "Completed" ? "bg-success" :
                                                                    item.Status == "Cancelled" ? "bg-secondary" :
                                                                                                  "bg-warning text-dark")">
                                @item.Status
                            </span>
                        </td>
                        <td>@(item.Notes ?? "-")</td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.ScheduleId"
                               class="btn btn-sm btn-info">Details</a>

                            @if (item.Status == "Scheduled")
                            {
                                <a asp-action="RecordHarvest"
                                       asp-route-id="@item.ScheduleId"
                                       class="btn btn-sm btn-success">
                                    Record Harvest
                                </a>
                            }

                            <form asp-action="Delete"
                                  asp-route-id="@item.ScheduleId"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this schedule?')">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>