@model IEnumerable<FarmManagement.Models.HarvestSchedule>
@{
    ViewData["Title"] = "All Schedules";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-semibold">Harvest Schedules</h2>
        <div class="d-flex gap-2">
            <a asp-action="HarvestList" class="btn btn-outline-success">Upcoming Harvests</a>
            <a asp-action="Create" class="btn btn-success">+ New Schedule</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Crop</th>
                        <th>Scheduled Date</th>
                        <th>Expected Yield</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Crop?.CropName</td>
                            <td>@item.ScheduledDate.ToString("dd MMM yyyy")</td>
                            <td>@item.ExpectedYieldKg kg</td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                            </td>
                            <td class="text-muted small">@(item.Notes ?? "—")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.HarvestScheduleId"
                                   class="btn btn-sm btn-outline-info">Details</a>
                                @if (item.Status != "Completed")
                                {
                                    <a asp-action="RecordHarvest" asp-route-id="@item.HarvestScheduleId"
                                       class="btn btn-sm btn-success">Record</a>
                                }
                                <form asp-action="Delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this schedule?')">
                                    <input type="hidden" name="id" value="@item.HarvestScheduleId" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No schedules found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>