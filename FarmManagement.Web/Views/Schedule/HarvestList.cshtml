@model IEnumerable<FarmManagement.Models.HarvestSchedule>
@{
    ViewData["Title"] = "Upcoming Harvests";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-semibold">Upcoming Harvests</h2>
        <a asp-action="Create" class="btn btn-success">+ Schedule Harvest</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Crop</th>
                        <th>Scheduled Date</th>
                        <th>Expected Yield</th>
                        <th>Days Remaining</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var daysLeft = (item.ScheduledDate - DateTime.Today).Days;
                        <tr>
                            <td class="fw-semibold">@item.Crop?.CropName</td>
                            <td>@item.ScheduledDate.ToString("dd MMM yyyy")</td>
                            <td>@item.ExpectedYieldKg kg</td>
                            <td>
                                @if (daysLeft < 0)
                                {
                                    <span class="text-danger">Overdue</span>
                                }
                                else if (daysLeft <= 7)
                                {
                                    <span class="text-warning fw-semibold">@daysLeft days</span>
                                }
                                else
                                {
                                    <span>@daysLeft days</span>
                                }
                            </td>
                            <td><span class="badge bg-warning text-dark">@item.Status</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.HarvestScheduleId"
                                   class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="RecordHarvest" asp-route-id="@item.HarvestScheduleId"
                                   class="btn btn-sm btn-success">Record</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No upcoming harvests in the next 30 days.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>