@model IEnumerable<FarmManagement.Web.Models.Entities.PlantingSchedule>

@{
    ViewData["Title"] = "Upcoming Harvests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-basket"></i> Upcoming Harvests</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-calendar3"></i> All Schedules
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        No upcoming harvests in the next 30 days.
    </div>
}
else
{
    <div class="alert alert-success">
        <i class="bi bi-calendar-check"></i>
        <strong>@Model.Count()</strong> harvest(s) scheduled in the next 30 days.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-success">
                    <tr>
                        <th>#</th>
                        <th>Crop</th>
                        <th>Field</th>
                        <th>Scheduled Date</th>
                        <th>Days Remaining</th>
                        <th>Expected Yield (kg)</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var daysLeft = (item.ScheduledDate - DateTime.Today).Days;
                        <tr class="@(daysLeft <= 7 ? "table-warning" : "")">
                            <td>@item.ScheduleId</td>
                            <td>@(item.Crop?.CropName ?? "-")</td>
                            <td>@(item.Field?.FieldName ?? "-")</td>
                            <td>@item.ScheduledDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (daysLeft == 0)
                                {
                                    <span class="badge bg-danger">Today</span>
                                }
                                else if (daysLeft <= 7)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @daysLeft day(s)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        @daysLeft day(s)
                                    </span>
                                }
                            </td>
                            <td>@item.ExpectedYieldKg kg</td>
                            <td>@(item.Notes ?? "-")</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.ScheduleId"
                                   class="btn btn-sm btn-info">Details</a>
                                <a asp-action="RecordHarvest"
                                       asp-route-id="@item.ScheduleId"
                                       class="btn btn-sm btn-success">
                                    Record Harvest
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}