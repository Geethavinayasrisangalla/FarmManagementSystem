@model FarmManagement.Web.Models.Entities.PlantingSchedule

@{
    ViewData["Title"] = "Schedule Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-calendar3"></i> Schedule Details</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <!-- Schedule Info -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-info-circle"></i> Schedule Information
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Schedule ID</dt>
                    <dd class="col-sm-7">@Model.ScheduleId</dd>

                    <dt class="col-sm-5">Crop</dt>
                    <dd class="col-sm-7">@(Model.Crop?.CropName ?? "-")</dd>

                    <dt class="col-sm-5">Field</dt>
                    <dd class="col-sm-7">@(Model.Field?.FieldName ?? "-")</dd>

                    <dt class="col-sm-5">Scheduled Date</dt>
                    <dd class="col-sm-7">
                        @Model.ScheduledDate.ToString("dd MMM yyyy")
                    </dd>

                    <dt class="col-sm-5">Expected Yield</dt>
                    <dd class="col-sm-7">@Model.ExpectedYieldKg kg</dd>

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        <span class="badge
                            @(Model.Status == "Scheduled" ? "bg-primary" :
                                                            Model.Status == "Completed" ? "bg-success" :
                                                            Model.Status == "Cancelled" ? "bg-secondary" :
                                                                                           "bg-warning text-dark")">
                            @Model.Status
                        </span>
                    </dd>

                    <dt class="col-sm-5">Notes</dt>
                    <dd class="col-sm-7">@(Model.Notes ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Harvest Records -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white">
                <i class="bi bi-basket"></i> Harvest Records
            </div>
            <div class="card-body">
                @if (Model.Harvests == null || !Model.Harvests.Any())
                {
                    <p class="text-muted">No harvest recorded yet.</p>

                    @if (Model.Status == "Scheduled")
                    {
                        <a asp-action="RecordHarvest"
                               asp-route-id="@Model.ScheduleId"
                               class="btn btn-success btn-sm">
                            <i class="bi bi-plus-circle"></i> Record Harvest
                        </a>
                    }
                }
                else
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-success">
                            <tr>
                                <th>Harvested Date</th>
                                <th>Actual Yield (kg)</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var harvest in Model.Harvests)
                            {
                                <tr>
                                    <td>
                                        @harvest.HarvestedDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="fw-semibold text-success">
                                        @harvest.ActualYieldKg kg
                                    </td>
                                    <td>@(harvest.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Resource Usages -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <i class="bi bi-box-seam"></i> Resources Used
            </div>
            <div class="card-body">
                @if (Model.ResourceUsages == null || !Model.ResourceUsages.Any())
                {
                    <p class="text-muted">No resources allocated to this schedule.</p>
                }
                else
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-warning">
                            <tr>
                                <th>Resource</th>
                                <th>Quantity Used</th>
                                <th>Used Date</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usage in Model.ResourceUsages)
                            {
                                <tr>
                                    <td>@(usage.Resource?.Name ?? "-")</td>
                                    <td>@usage.QuantityUsed @(usage.Resource?.Unit ?? "")</td>
                                    <td>@usage.UsedDate.ToString("dd MMM yyyy")</td>
                                    <td>@(usage.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (Model.Status == "Scheduled")
    {
        <a asp-action="RecordHarvest"
               asp-route-id="@Model.ScheduleId"
               class="btn btn-success">
            <i class="bi bi-basket"></i> Record Harvest
        </a>
    }

    <form asp-action="Delete"
          asp-route-id="@Model.ScheduleId"
          method="post" class="d-inline"
          onsubmit="return confirm('Delete this schedule?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger ms-2">
            <i class="bi bi-trash"></i> Delete
        </button>
    </form>
</div>