@model FarmManagement.Web.Models.Entities.PlantingSchedule
@{
    ViewData["Title"] = "Schedule Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">📋 Schedule #@Model.ScheduleId Details</h4>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="45%">Schedule ID</th>
                            <td>@Model.ScheduleId</td>
                        </tr>
                        <tr>
                            <th>Crop ID</th>
                            <td>@Model.CropId</td>
                        </tr>
                        <tr>
                            <th>Field ID</th>
                            <td>@Model.FieldId</td>
                        </tr>
                        <tr>
                            <th>Planting Date</th>
                            <td>@Model.PlantingDate.ToString("dd MMM yyyy")</td>
                        </tr>
                        <tr>
                            <th>Est. Harvest Date</th>
                            <td>@Model.EstimatedHarvestDate.ToString("dd MMM yyyy")</td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>
                                @if (Model.Status == "Planned")
                                {
                                    <span class="badge bg-secondary fs-6">📋 Planned</span>
                                }
                                else if (Model.Status == "Active")
                                {
                                    <span class="badge bg-primary fs-6">🌿 Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-success fs-6">✅ Completed</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">← Back to List</a>

                    @if (Model.Status == "Active")
                    {
                        <a asp-action="RecordHarvest" asp-route-id="@Model.ScheduleId"
                           class="btn btn-warning ms-2">🌾 Record Harvest</a>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

