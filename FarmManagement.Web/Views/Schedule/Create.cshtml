@model FarmManagement.Web.Models.Entities.PlantingSchedule
@{
    ViewData["Title"] = "Create Planting Schedule";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">🌱 New Planting Schedule</h4>
                </div>
                <div class="card-body">

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="alert alert-danger
                        d-none" id="validationSummary"></div>

                        <div class="mb-3">
                            <label asp-for="CropId" class="form-label fw-bold"></label>
                            <input asp-for="CropId" class="form-control"
                                   placeholder="Enter Crop ID" />
                            <span asp-validation-for="CropId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FieldId" class="form-label fw-bold"></label>
                            <input asp-for="FieldId" class="form-control"
                                   placeholder="Enter Field ID" />
                            <span asp-validation-for="FieldId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PlantingDate" class="form-label fw-bold"></label>
                            <input asp-for="PlantingDate" type="date" class="form-control" />
                            <span asp-validation-for="PlantingDate"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EstimatedHarvestDate"
                                   class="form-label fw-bold"></label>
                            <input asp-for="EstimatedHarvestDate" type="date"
                                   class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success w-100">
                                💾 Save Schedule
                            </button>
                            <a asp-action="Index" class="btn btn-secondary w-100">
                                Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Show validation summary if errors exist
        var summary = document.getElementById('validationSummary');
        if (summary && summary.querySelectorAll('li').length > 0) {
            summary.classList.remove('d-none');
        }
    </script>
}
