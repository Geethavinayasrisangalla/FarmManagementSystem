@model FarmManagement.Web.Models.ViewModels.ScheduleViewModel

@{
    ViewData["Title"] = "New Planting Schedule";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-calendar-plus"></i> New Planting Schedule</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CropId" class="form-label"></label>
                    <select asp-for="CropId" class="form-select"
                            asp-items="Model.Crops">
                        <option value="">-- Select Crop --</option>
                    </select>
                    <span asp-validation-for="CropId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FieldId" class="form-label"></label>
                    <select asp-for="FieldId" class="form-select"
                            asp-items="Model.Fields">
                        <option value="">-- Select Field --</option>
                    </select>
                    <span asp-validation-for="FieldId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ScheduledDate" class="form-label"></label>
                    <input asp-for="ScheduledDate" class="form-control"
                           type="date" />
                    <span asp-validation-for="ScheduledDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ExpectedYieldKg" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ExpectedYieldKg" class="form-control"
                               placeholder="e.g. 3500" />
                        <span class="input-group-text">kg</span>
                    </div>
                    <span asp-validation-for="ExpectedYieldKg" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="Optional notes about this schedule..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Save Schedule
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}