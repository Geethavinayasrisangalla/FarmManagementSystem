@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card-body">
        <h4 class="fw-bold mb-1" style="color:#1a3c2b;">Welcome back</h4>
        <p class="text-muted small mb-4">Sign in to your account to continue</p>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="you@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0"
                           style="border-radius:0 10px 10px 0;"
                           placeholder="Enter your password" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex align-items-center justify-content-between">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
                </div>
                <a asp-action="ForgotPassword" class="small text-decoration-none" style="color:#16a34a;">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-auth">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <span class="auth-footer-text">Don't have an account?</span>
        <a asp-action="Register" class="auth-footer-link ms-1">Create one here</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
