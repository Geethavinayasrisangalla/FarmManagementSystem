@model IEnumerable<FarmManagement.Web.Models.Entities.PestIncident>

@{
    ViewData["Title"] = "Pest Incidents";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-bug"></i> Pest Incidents</h2>
    <a asp-action="Create" class="btn btn-danger">
        <i class="bi bi-plus-circle"></i> Log Incident
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-danger">
                <tr>
                    <th>#</th>
                    <th>Pest Name</th>
                    <th>Crop</th>
                    <th>Description</th>
                    <th>Reported Date</th>
                    <th>Status</th>
                    <th>Treatment Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            No pest incidents recorded.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PestIncidentId</td>
                        <td>@item.PestName</td>
                        <td>@(item.Crop?.CropName ?? "-")</td>
                        <td>@(item.Description ?? "-")</td>
                        <td>@item.ReportedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge
                                @(item.Status == FarmManagement.Web.Models.Enums.IncidentStatus.Active
                                                                      ? "bg-danger" :
                                                                    item.Status == FarmManagement.Web.Models.Enums.IncidentStatus.Monitoring
                                                                      ? "bg-warning text-dark" : "bg-success")">
                                @item.Status
                            </span>
                        </td>
                        <td>@(item.TreatmentNotes ?? "-")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.PestIncidentId"
                               class="btn btn-sm btn-info">Details</a>

                            <!-- Update Status Form -->
                            <button type="button" class="btn btn-sm btn-warning"
                                    data-bs-toggle="modal"
                                    data-bs-target="#statusModal-@item.PestIncidentId">
                                Update
                            </button>

                            <form asp-action="Delete" asp-route-id="@item.PestIncidentId"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete @item.PestName incident?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>

                    <!-- Update Status Modal -->
                    <div class="modal fade" id="statusModal-@item.PestIncidentId"
                         tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header bg-warning text-dark">
                                    <h5 class="modal-title">
                                        Update Status — @item.PestName
                                    </h5>
                                    <button type="button" class="btn-close"
                                            data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id"
                                           value="@item.PestIncidentId" />
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">New Status</label>
                                            <select name="status" class="form-select">
                                                <option value="Active">Active</option>
                                                <option value="Monitoring">Monitoring</option>
                                                <option value="Resolved">Resolved</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Treatment Notes</label>
                                            <textarea name="treatmentNotes"
                                                      class="form-control" rows="3"
                                                      placeholder="Describe treatment applied...">@item.TreatmentNotes</textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary"
                                                data-bs-dismiss="modal">
                                            Cancel
                                        </button>
                                        <button type="submit" class="btn btn-warning">
                                            Save Changes
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>