@model IEnumerable<FarmManagement.Web.Models.Entities.PestIncident>

@{
    ViewData["Title"] = "Pest Incidents";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>
            <span class="ph-icon" style="background:#fee2e2;color:#dc2626;">
                <i class="bi bi-bug"></i>
            </span>
            Pest Incidents
        </h1>
        <p>Track and manage pest and disease incidents across crops.</p>
    </div>
    <a asp-action="Create" class="btn-fm btn-danger-fm">
        <i class="bi bi-plus-circle"></i> Log Incident
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="fm-alert fm-alert-success mb-3">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="fm-alert fm-alert-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<form method="get" class="mb-3 d-flex gap-2" style="max-width:400px;">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search pests or crops..." />
    <button type="submit" class="btn-fm btn-danger-fm"><i class="bi bi-search"></i></button>
    @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
    {
        <a asp-action="Index" class="btn-fm btn-outline-fm"><i class="bi bi-x-lg"></i></a>
    }
</form>

<div class="fm-card">
    <div class="fm-card-header">
        <span class="ch-title">
            <i class="bi bi-table" style="color:#dc2626;"></i>
            All Incidents
        </span>
        <span style="font-size:.78rem;color:var(--fm-muted);">@Model.Count() records</span>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-shield-check"></i>
            <p>No pest incidents recorded. Your crops are healthy!</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Pest Name</th>
                        <th>Crop</th>
                        <th>Description</th>
                        <th>Reported</th>
                        <th>Status</th>
                        <th>Treatment Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var pestBadge = item.Status switch {
                            FarmManagement.Web.Models.Enums.IncidentStatus.Active     => "badge-red",
                            FarmManagement.Web.Models.Enums.IncidentStatus.Monitoring => "badge-yellow",
                            _                                                          => "badge-green"
                        };
                        <tr>
                            <td style="color:var(--fm-muted);font-size:.8rem;">@item.PestIncidentId</td>
                            <td style="font-weight:600;">@item.PestName</td>
                            <td>@(item.Crop?.CropName ?? "—")</td>
                            <td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @(item.Description ?? "—")
                            </td>
                            <td>@item.ReportedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge-pill @pestBadge">@item.Status</span>
                            </td>
                            <td style="max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @(item.TreatmentNotes ?? "—")
                            </td>
                            <td>
                                <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
                                    <button type="button"
                                            class="btn-fm btn-warn-fm btn-sm-fm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#statusModal-@item.PestIncidentId">
                                        <i class="bi bi-pencil"></i> Update
                                    </button>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Farmer"))
                                    {
                                        <form asp-action="Delete"
                                              asp-route-id="@item.PestIncidentId"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Delete @item.PestName incident?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-fm btn-danger-fm btn-sm-fm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@foreach (var item in Model)
{
    <div class="modal fade" id="statusModal-@item.PestIncidentId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:var(--fm-radius);border:1px solid var(--fm-border);">
                <div class="modal-header" style="background:var(--fm-dark);color:#fff;border-radius:var(--fm-radius) var(--fm-radius) 0 0;">
                    <h5 class="modal-title" style="font-size:.95rem;font-weight:600;">
                        <i class="bi bi-pencil-square me-2"></i>Update — @item.PestName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.PestIncidentId" />
                    <div class="modal-body fm-form" style="padding:1.25rem;">
                        <div class="mb-3">
                            <label class="form-label">New Status</label>
                            @Html.DropDownList(
                                "status",
                                new SelectList(
                                    new[]
                                    {
                                        new { Value = "Active",     Text = "Active"     },
                                        new { Value = "Monitoring", Text = "Monitoring" },
                                        new { Value = "Resolved",   Text = "Resolved"   }
                                    },
                                    "Value", "Text",
                                    item.Status.ToString()
                                ),
                                new { @class = "form-select form-control" }
                            )
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Treatment Notes</label>
                            <textarea name="treatmentNotes" class="form-control"
                                      rows="3" placeholder="Describe treatment applied...">@item.TreatmentNotes</textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--fm-border);padding:.85rem 1.25rem;">
                        <button type="button" class="btn-fm btn-ghost-fm btn-sm-fm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-fm btn-primary-fm btn-sm-fm">
                            <i class="bi bi-check-circle"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
