@model FarmManagement.Web.Models.Entities.PestIncident

@{
    ViewData["Title"] = "Log Pest Incident";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-bug"></i> Log Pest Incident</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PestName" class="form-label">Pest Name</label>
                    <input asp-for="PestName" class="form-control"
                           placeholder="e.g. Aphids, Brown Plant Hopper" />
                    <span asp-validation-for="PestName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CropId" class="form-label">Affected Crop</label>
                    <select asp-for="CropId" class="form-select">
                        <option value="">-- Select Crop --</option>
                        @if (ViewBag.Crops != null)
                        {
                            @foreach (var crop in ViewBag.Crops)
                            {
                                <option value="@crop.CropId">@crop.CropName</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CropId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Describe the pest incident in detail..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                Incident will be logged with today's date and marked as
                <strong>Active</strong> automatically.
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-exclamation-triangle"></i> Log Incident
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}