@model FarmManagement.Web.Models.Entities.PestIncident

@{
    ViewData["Title"] = "Log Treatment";
    var currentStatus = Model.Status.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-capsule"></i> Log Treatment</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row g-4">
    <!-- Incident Summary -->
    <div class="col-md-4">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-bug"></i> Incident Summary
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Pest</dt>
                    <dd class="col-sm-7">@Model.PestName</dd>

                    <dt class="col-sm-5">Crop</dt>
                    <dd class="col-sm-7">@(Model.Crop?.CropName ?? "-")</dd>

                    <dt class="col-sm-5">Reported</dt>
                    <dd class="col-sm-7">
                        @Model.ReportedDate.ToString("dd MMM yyyy")
                    </dd>

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        <span class="badge
                            @(Model.Status == FarmManagement.Web.Models.Enums.IncidentStatus.Active
                                                              ? "bg-danger" :
                                                            Model.Status == FarmManagement.Web.Models.Enums.IncidentStatus.Monitoring
                                                              ? "bg-warning text-dark" : "bg-success")">
                            @Model.Status
                        </span>
                    </dd>

                    <dt class="col-sm-5">Description</dt>
                    <dd class="col-sm-7">@(Model.Description ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Treatment Form -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <i class="bi bi-pencil-square"></i> Update Status & Treatment
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.PestIncidentId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Update Status</label>
                            <!-- fixed: use Html.DropDownList instead of
                                 manual option tags with inline C# -->
                            @Html.DropDownList("status",
                                new SelectList(
                                    new[]
                                    {
                                        new { Value = "Active",     Text = "Active"     },
                                        new { Value = "Monitoring", Text = "Monitoring" },
                                        new { Value = "Resolved",   Text = "Resolved"   }
                                    },
                                    "Value",
                                    "Text",
                                    currentStatus
                                ),
                                new { @class = "form-select" }
                            )
                        </div>

                        <div class="col-12">
                            <label class="form-label">Treatment Notes</label>
                            <textarea name="treatmentNotes"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe treatment applied, chemicals used, dosage etc.">@Model.TreatmentNotes</textarea>
                        </div>

                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-info-circle"></i>
                                Updating to <strong>Resolved</strong> will mark
                                this incident as closed. Treatment notes will be
                                saved directly on this incident record.
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-circle"></i> Save Treatment
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>