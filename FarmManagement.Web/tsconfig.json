{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "wwwroot/js",
    "rootDir": "Scripts",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["Scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
